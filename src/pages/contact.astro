---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Grid from '../components/Grid.astro';
import { EMAIL, mailto } from '../lib/site';
import SocialIcons from '../components/SocialIcons.astro';
import { url } from '../lib/url';

// Copy: src/content/copy/contact.md (Draft). No form until a backend and routing are chosen
// (docs/07-open-questions.md); each topic opens an email to info@fsic.space with the subject set.
// Each topic also links to the page that answers it, before the email link.
// Not on the page until confirmed: a phone number, a named media contact.

const topics = [
  {
    name: 'Partnerships',
    line: 'Employers, school districts, colleges and universities, local government, workforce agencies, and civic organizations.',
    page: { path: '/partnership-funding#partners', text: 'How each partner takes part' },
    linkText: 'Email about a partnership',
    subject: 'Partnership inquiry',
  },
  {
    name: 'Volunteering and leadership',
    line: "FSIC is actively seeking leaders and volunteers with relevant experience across the Center's four core engines — Talent, Innovation, Market, and Civic.",
    page: { path: '/partnership-funding#get-involved', text: 'Ways to get involved' },
    linkText: 'Email about volunteering',
    subject: 'Volunteer or leadership interest',
  },
  {
    name: 'Media',
    line: 'Press inquiries.',
    page: { path: '/news', text: 'Press releases' },
    linkText: 'Email a media inquiry',
    subject: 'Media inquiry',
  },
  {
    name: 'General',
    line: 'Questions about FSIC and its plans.',
    page: { path: '/faq', text: 'Frequently asked questions' },
    linkText: 'Email FSIC',
    subject: 'General inquiry',
  },
];
---
<BaseLayout title="Contact" description="Contact the Florida Space Innovation Center about partnerships, volunteering and leadership, media inquiries, or general questions.">

  <!-- Interior page template (DESIGN.md): PageHero; the aside carries the one instruction -->
  <PageHero title="Let's Work Together">
    <p slot="aside">
      Every message goes to {EMAIL}. Choose a topic to open an email with the subject filled in.
    </p>
    <p class="text-lead text-white/90 mb-0">
      Get in touch so we can start working together. Whether you are an employer, educator, policymaker, or community member, there is a role to play.
    </p>
  </PageHero>

  <!-- The address as the page's one statement (cols 1–4) | the four topics as peers, a 2×2 grid
       hung from its top rules (cols 5–12). No section rule or headline: the hero already names the page. -->
  <Section rule={false}>
    <Grid class="gap-y-10" labelOffset>
      <div slot="label">
        <a href={mailto()} class="font-display text-3xl font-semibold leading-snug text-navy underline underline-offset-[6px] decoration-2 decoration-navy/25 hover:decoration-navy">{EMAIL}</a>
        <dl class="mt-8 space-y-4 text-caption">
          <div>
            <dt class="font-semibold text-navy">Location</dt>
            <dd class="text-gray-dark">New Smyrna Beach, Florida</dd>
          </div>
          <div>
            <dt class="font-semibold text-navy">Follow FSIC</dt>
            <dd>
              <SocialIcons class="mt-1" />
            </dd>
          </div>
        </dl>
      </div>

      <div class="grid gap-x-8 gap-y-10 md:grid-cols-2">
        {topics.map((t) => (
          <div class="flex flex-col border-t-2 border-navy pt-5">
            <h2 class="text-2xl mb-3">{t.name}</h2>
            <p class="mb-4 text-gray-dark">{t.line}</p>
            <p class="mb-4 text-caption"><a href={url(t.page.path)} class="link">{t.page.text}</a></p>
            <p class="mt-auto mb-0 font-sans font-semibold">
              <a href={mailto(t.subject)} class="link">{t.linkText}</a>
            </p>
          </div>
        ))}
      </div>
    </Grid>
  </Section>

</BaseLayout>
