---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import PageHero from '../components/PageHero.astro';
import SectionBar from '../components/SectionBar.astro';
import Section from '../components/Section.astro';
import Grid from '../components/Grid.astro';
import Row from '../components/Row.astro';
import List from '../components/List.astro';
import { pad2 } from '../lib/format';
import Closing from '../components/Closing.astro';
import { phases, type Tone } from '../data/phases';
import { url } from '../lib/url';

// Copy: src/content/copy/deployment.md (Draft). Five-phase model from the Master Plan (pp. 13–14),
// chosen by the project lead; facilities lines from p. 18. Open review items: facilities/location
// (audit §3.3) and the year-by-year milestones, which the page leaves out (see the copy deck).

const YEARS = [1, 2, 3, 4, 5];
// Bar colors on night (hero) and as list markers on white (sections)
const barOnNight: Record<Tone, string> = { orange: 'bg-orange', lagoon: 'bg-lagoon-light', navy: 'bg-white/80' };
---
<BaseLayout title="Phased Deployment" description="How the Florida Space Innovation Center scales in five phases over five years, from the Talent Engine launch to full ecosystem integration.">

  <!-- Interior page template (DESIGN.md): PageHero with a phase timeline as the index, spec sections, closing -->
  <PageHero title="Start Small. Deliver Early Wins. Scale with Readiness.">
    <div slot="aside" class="max-w-sm">
      <p class="text-label text-white mb-3">This phased approach:</p>
      <List items={['Reduces risk', 'Aligns with funding cycles', 'Ensures operational discipline', 'Builds momentum before expansion']} class="text-caption text-white/75" />
    </div>

    <p class="text-lead text-white/90 mb-10">
      The Florida Space Innovation Center is intentionally designed as a phased, scalable model that reduces risk, builds early momentum, and aligns with regional capacity. Each phase strengthens the next, ensuring that FSIC grows in a financially responsible, strategically aligned, and operationally sustainable manner.
    </p>

    <!-- Phase timeline: name (left) | Years 1–5 track (right). Each row links to its phase. -->
    <nav aria-label="The five phases" class="font-sans">
      <div class="hidden md:grid md:grid-cols-[minmax(0,3fr)_minmax(0,5fr)] md:gap-x-6 border-b border-rule-on-dark pb-2" aria-hidden="true">
        <span></span>
        <span class="grid grid-cols-5 text-sm text-white/60 tabular-nums">
          {YEARS.map((y) => <span>Year {y}</span>)}
        </span>
      </div>
      <ol class="border-t border-rule-on-dark md:border-t-0">
        {phases.map((phase, i) => (
          <li class="border-b border-rule-on-dark">
            <a href={`#${phase.id}`} class="group grid gap-y-2 md:grid-cols-[minmax(0,3fr)_minmax(0,5fr)] md:gap-x-6 md:items-center py-3.5">
              <span class="flex items-baseline gap-3">
                <span class="text-sm text-white/60 tabular-nums">{pad2(i + 1)}</span>
                <span>
                  <span class="block font-display text-xl font-semibold text-white underline-reveal underline-offset-4 decoration-2 leading-tight">{phase.name}</span>
                  <span class="block text-sm text-white/75">{phase.timeframe}</span>
                </span>
              </span>
              <span class="grid grid-cols-5 h-3 bg-white/[0.06]" aria-hidden="true">
                <span
                  class:list={['h-full', barOnNight[phase.tone]]}
                  style={`grid-column: ${phase.start} / ${phase.end + 1}`}
                ></span>
              </span>
            </a>
          </li>
        ))}
      </ol>
      <p class="mt-3 mb-0 text-sm text-white/60">Timeframes: FSIC Master Plan 2026–2031.</p>
    </nav>
  </PageHero>

  <!-- The wrapper bounds the sticky bar to the phase sections -->
  <div>
    <SectionBar
      ariaLabel="Phases on this page"
      numbered
      items={phases.map((phase, i) => ({ id: phase.id, label: phase.short, srSuffix: `: Phase ${i + 1}` }))}
    />

    {phases.map((phase, i) => (
      <Section
        id={phase.id}
        index={i + 1}
        total={phases.length}
        dot={phase.tone === 'navy' ? undefined : phase.tone}
        labelledby={`${phase.id}-title`}
      >
        <Grid labelAs="header">
          <Fragment slot="label">
            <p class="text-label text-navy mb-2">Phase {i + 1} · {phase.timeframe}</p>
            <h2 id={`${phase.id}-title`} class="mb-0">{phase.name}</h2>
          </Fragment>

          <p class="text-lead text-navy mb-10 max-w-3xl lg:pt-1">{phase.overview}</p>

          <dl>
            <Row label="Core activities">
              <List items={phase.activities} class="text-gray-dark" />
            </Row>
            <Row label="Key outcomes" dot={phase.tone}>
              <List items={phase.outcomes} class="text-navy" />
            </Row>
            <Row label="Facilities" class="border-b border-rule">
              <p class="mb-2 text-gray-dark">{phase.facilities}</p>
              <p class="mb-0 text-caption"><a href={url('/programs-facilities#facilities')} class="link">Planned spaces for each phase</a></p>
            </Row>
          </dl>
        </Grid>
      </Section>
    ))}
  </div>

  <!-- SUSTAINABILITY (fsic.space/about-4; 30–50% confirmed in Master Plan pp. 2, 27) -->
  <Section dark>
    <Grid>
      <h2 slot="label" class="text-white mb-0">A Phased Model That Reduces Risk and Builds Momentum</h2>
      <p class="text-lead text-white/90 mb-8 max-w-3xl">
        FSIC launches with a lean operational model supported by philanthropic investment, in-kind contributions, and early public-private partnerships. Over three years, FSIC transitions from startup to full Talent Engine activation, supported by <a href={url('/partnership-funding#funding')} class="link-on-dark">diversified revenue streams</a> including grants, employer partnerships, earned revenue, and corporate sponsorships.
      </p>
      <p class="text-white/75 mb-0 max-w-3xl pt-6 border-t border-rule-on-dark">
        By Year 3, FSIC is positioned to sustain 30–50% of its operating budget through recurring earned revenue and employer partnerships, with grants and philanthropy fueling innovation and growth.
      </p>
    </Grid>
  </Section>

  <!-- CLOSING -->
  <Closing statement="Growth is structured. Not speculative.">
    <Button href="/model">Learn More About the FSIC Model</Button>
    <Button href="/economic-impact" variant="secondary">Explore the Full Economic Analysis</Button>
  </Closing>

</BaseLayout>
