---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';

// Copy: src/content/copy/model.md (Draft). Wording is verbatim from the copy deck.
// Open review items (see model.md ⚠): the "Brings together" lists, the Civic shift line, and the
// startup overlap between the Innovation and Market engines.

type Engine = {
  id: string;
  name: string;
  tone: 'orange' | 'lagoon';
  shift: string;
  launchesFirst: boolean;
  summary: string[];
  together: string[];
  solves: string[];
  impact: string[];
  components: { title: string; body: string }[];
};

const engines: Engine[] = [
  {
    id: 'talent',
    name: 'Talent Engine',
    tone: 'orange',
    shift: 'Transforming individuals into skilled talent',
    launchesFirst: true,
    summary: [
      'A coordinated, employer-validated workforce pipeline aligned to launch operations, spacecraft manufacturing, advanced manufacturing, robotics, and dual-use technologies.',
    ],
    together: ["Students", "Educators", "Employers"],
    solves: [
      "Fragmented talent pipelines",
      "Lack of space-specific training",
      "Insufficient hands-on learning",
      "Limited employer access to local talent",
      "Weak alignment between education and industry",
    ],
    impact: [
      "Increases the supply of job-ready talent",
      "Reduces hiring friction for employers",
      "Strengthens regional competitiveness",
      "Expands economic mobility for residents",
      "Positions Southeast Volusia as a workforce hub for the Space Coast",
    ],
    components: [
      { title: 'STEM & Early Exposure Programs', body: "Hands-on STEM and space-focused learning experiences for K–12 students that spark curiosity, build foundational skills, and connect young learners to real opportunities in the region's growing space economy." },
      { title: 'Technical Training & Micro-Credentials', body: 'Short-form, industry-aligned training that equips learners with the technical skills employers need today. Micro-credentials and certifications help residents quickly qualify for high-wage roles in space, aerospace, advanced manufacturing, and related sectors.' },
      { title: 'Internships, Apprenticeships & Work-Based Learning', body: 'Structured pathways that place students and adults directly inside local companies. These experiences build real-world skills, strengthen employer pipelines, and increase job placements for Southeast Volusia residents.' },
      { title: 'University Partnerships & Degree Pathways', body: 'Collaborations with regional and national universities that bring new programs, research opportunities, and degree pathways to Southeast Volusia. These partnerships expand access to higher education and anchor long-term economic growth.' },
      { title: 'Employer Engagement & Talent Alignment', body: 'Continuous collaboration with employers to identify workforce needs, shape curriculum, and ensure training programs lead directly to high-wage jobs. This alignment strengthens local hiring and keeps talent in the community.' },
      { title: 'Community Access & On-Ramps', body: 'Inclusive programs that make space and technology careers accessible to residents of all ages and backgrounds. These on-ramps help adults re-skill, help students explore new futures, and ensure the benefits of growth reach the entire community.' },
    ],
  },
  {
    id: 'innovation',
    name: 'Innovation Engine',
    tone: 'orange',
    shift: 'Transforming knowledge into innovation',
    launchesFirst: false,
    summary: [
      "The region's first civilian-facing applied innovation hub.",
      'Enables students, educators, researchers, startups, and industry partners to collaborate on real aerospace and advanced technology challenges.',
      'Accelerates prototyping, applied research, and dual-use technology development.',
    ],
    together: ["Industry", "Universities", "Startups", "Community partners"],
    solves: [
      "No civilian innovation hub on the Space Coast",
      "Limited applied research capacity",
      "Lack of shared prototyping and testing facilities",
      "Weak industry-university collaboration",
      "No platform for dual-use technology development",
    ],
    impact: [
      "Accelerates R&D and commercialization",
      "Strengthens university partnerships",
      "Attracts federal innovation funding",
      "Builds a culture of problem-solving and experimentation",
      "Positions Southeast Volusia as a hub for dual-use innovation",
    ],
    components: [
      { title: 'Challenge Labs & Problem-Solving Sprints', body: 'Structured programs where industry, government, and community partners bring real challenges for teams of students, researchers, and innovators to solve. These labs generate new ideas, prototypes, and pathways for commercialization.' },
      { title: 'Rapid Prototyping & Maker Capabilities', body: 'Hands-on spaces and tools that allow innovators to quickly design, build, and test early-stage concepts. This accelerates learning, reduces risk, and helps founders and students move from idea to prototype faster.' },
      { title: 'Applied Research Partnerships', body: "Collaborations between universities, employers, and researchers that turn scientific and technical expertise into real-world solutions. These partnerships strengthen the region's research capacity and attract new academic investment." },
      { title: 'Startup Support & Venture Acceleration', body: "Programs that help founders refine ideas, validate markets, build teams, and access mentors and partners. This support increases the number of viable startups and strengthens the region's entrepreneurial pipeline." },
      { title: 'Industry Collaboration & Technology Adoption', body: 'Ongoing engagement with employers to identify innovation needs, shape challenge topics, and accelerate the adoption of new technologies across the region. This ensures innovation activity is aligned with real market demand.' },
      { title: 'Innovation Community & Events', body: 'Meetups, workshops, hackathons, and showcases that bring together students, founders, researchers, and employers. These events build a visible, connected innovation culture across Southeast Volusia.' },
    ],
  },
  {
    id: 'market',
    name: 'Market Engine',
    tone: 'orange',
    shift: 'Transforming opportunity into market success',
    launchesFirst: false,
    summary: [
      'Strengthens the regional supplier base by helping companies secure certifications, navigate SBIR/STTR funding, access federal procurement pathways, and scale into sustainable ventures.',
      'Ensures innovation generated in the region becomes market-ready and economically impactful.',
    ],
    together: ["Local companies", "Buyers and primes", "Investors"],
    solves: [
      "Local companies locked out of supply chains",
      "Lack of certification and compliance support",
      "No regional accelerator or incubator",
      "Limited access to capital",
      "No structured pathway to federal procurement",
    ],
    impact: [
      "Strengthens the local supplier base",
      "Increases contract wins and federal funding",
      "Supports startup formation and growth",
      "Attracts employers seeking a ready ecosystem",
      "Diversifies the regional economy",
    ],
    components: [
      { title: 'Supplier Readiness & Certification Support', body: 'Training and guidance that help local companies meet the requirements of aerospace, defense, and advanced manufacturing supply chains. This includes support for quality systems, compliance, and key certifications that unlock new contract opportunities.' },
      { title: 'SBIR/STTR Navigation & Federal Funding Pathways', body: 'Hands-on assistance helping startups and small businesses pursue federal innovation funding. This includes topic scouting, proposal guidance, partner matching, and pathways into NSF, DoD, NASA, and other agency programs.' },
      { title: 'Startup Acceleration & Venture Support', body: 'Programs that help founders validate markets, refine business models, build teams, and access mentors and investors. This support strengthens early-stage companies and increases the number of scalable ventures in Southeast Volusia.' },
      { title: 'Contract Matchmaking & Industry Connections', body: 'Direct connections between local suppliers and regional buyers, primes, and government partners. These relationships open doors to new contracts, partnerships, and long-term business growth.' },
      { title: 'Business Growth Services & Technical Assistance', body: 'Targeted support that helps companies expand capacity, adopt new technologies, improve operations, and prepare for larger contracts. This strengthens the competitiveness of local firms across the region.' },
      { title: 'Investment & Capital Access Pathways', body: 'Connections to venture capital, angel investors, state programs, and federal funding opportunities. These pathways help companies secure the resources needed to scale and compete in the space and advanced technology sectors.' },
    ],
  },
  {
    id: 'civic',
    name: 'Civic Engine',
    tone: 'lagoon',
    shift: 'Transforming innovation into shared identity',
    launchesFirst: false,
    summary: [
      'Builds public trust, regional identity, and community engagement through STEM events, arts and space programming, public exhibitions, and transparent governance.',
      'Ensures innovation is visible, accessible, and meaningful to residents.',
    ],
    together: ["Residents", "Educators", "Employers", "Artists", "Civic leaders"],
    solves: [
      "Lack of public understanding of the space economy",
      "Weak regional identity",
      "Limited community access to STEM experiences",
      "Insufficient civic engagement",
      "Need for visible public benefit",
    ],
    impact: [
      "Builds community pride and belonging",
      "Strengthens civic trust and transparency",
      "Expands access to STEM opportunities",
      "Creates a shared narrative around regional growth",
      "Anchors Deering Park as a community destination",
    ],
    components: [
      { title: 'Community Engagement & Public Programming', body: "Accessible events, workshops, exhibitions, and hands-on activities that bring space, science, and technology into everyday community life. These programs build excitement, understanding, and pride in the region's growing space economy." },
      { title: 'STEM Culture & Youth Inspiration', body: "Initiatives that spark curiosity and expand access to STEM learning for students of all ages. These efforts help young people see themselves in future space and technology careers and strengthen the region's long-term talent pipeline." },
      { title: 'Storytelling, Branding & Regional Identity', body: "Public-facing narratives, campaigns, and creative collaborations that highlight Southeast Volusia's role in the space economy. This work builds a shared identity and reinforces the region's position as a rising innovation hub." },
      { title: 'Cross-Sector Convening & Coalition Building', body: 'Regular engagement with educators, employers, civic leaders, nonprofits, and community groups to align priorities, share resources, and strengthen regional collaboration. This ensures that growth benefits residents and supports long-term community goals.' },
      { title: 'Transparency, Governance & Public Trust', body: "Clear communication, open processes, and community-centered decision-making that build confidence in FSIC's mission and ensure residents feel included in shaping the region's future." },
      { title: 'Arts, Culture & Space Integration', body: "Creative programs that blend arts, storytelling, and space themes to make innovation feel accessible, inspiring, and uniquely tied to Southeast Volusia's identity." },
    ],
  },
];
---
<BaseLayout title="The FSIC Model" description="FSIC's four-engine architecture — Talent, Innovation, Market, and Civic — creates a coordinated regional innovation ecosystem.">

  <!--
    GRID: one 12-column grid for the whole page (Swiss layout).
    Label column = cols 1–4. Content column = cols 5–12.
    Inside the content column, sub-rows split into a sub-label (2 of 8) and sub-content (6 of 8),
    so every list on the page starts on the same vertical line.
    Hierarchy comes from position, scale and hairline rules, not boxes or fills.
  -->

  <!-- HERO: title across the full measure, then label | content -->
  <section class="bg-night text-white">
    <div class="container pt-14 pb-20 md:pt-20 md:pb-24">
      <h1 class="text-white max-w-5xl mb-12 md:mb-16">One Coordinated Platform. Four Integrated Engines.</h1>

      <div class="grid gap-y-10 lg:grid-cols-12 lg:gap-x-8 border-t border-white/25 pt-8">
        <p class="lg:col-span-4 mb-0 font-sans text-sm text-white/70 max-w-sm order-last lg:order-none">
          <dfn class="not-italic font-semibold text-white">Engine:</dfn>
          a coordinated system of people, programs, and partnerships designed to generate movement, produce results, and drive sustained progress. At FSIC, each Engine is a focused platform that brings partners together to solve problems, fill gaps, and create measurable outcomes for the region.
        </p>

        <div class="lg:col-span-8">
          <p class="text-2xl text-white/90 leading-snug mb-10">
            Each engine addresses a structural gap in the region's current capacity—talent, innovation, commercialization, and civic identity—and together they create the infrastructure required for Southeast Volusia to participate fully in the Space Coast economy.
          </p>

          <!-- Engine index: number, name, what it transforms. Launch order sits between 01 and 02. -->
          <nav aria-label="The four engines" class="font-sans">
            <ol class="border-t border-white/25">
              {engines.map((engine, i) => (
                <>
                  <li class="border-b border-white/25">
                    <a href={`#${engine.id}`} class="group grid grid-cols-[2.5rem_minmax(0,1fr)] sm:grid-cols-[2.5rem_minmax(0,1fr)_minmax(0,1.3fr)] gap-x-4 gap-y-1 py-4 rounded-sm">
                      <span class="text-sm text-white/60 tabular-nums pt-1.5">{String(i + 1).padStart(2, '0')}</span>
                      <span class="font-display text-2xl font-semibold text-white group-hover:underline underline-offset-4 decoration-2 flex items-center gap-3">
                        <span class:list={['w-2.5 h-2.5 shrink-0 rounded-full', engine.tone === 'lagoon' ? 'bg-lagoon-light' : 'bg-orange']} aria-hidden="true"></span>
                        {engine.name}
                      </span>
                      <span class="col-start-2 sm:col-start-auto text-white/70 sm:pt-1.5">{engine.shift}</span>
                    </a>
                  </li>
                  {engine.launchesFirst && (
                    <li class="border-b border-white/25 grid grid-cols-[2.5rem_minmax(0,1fr)] gap-x-4 py-4">
                      <span></span>
                      <p class="mb-0 text-sm text-white/70 max-w-xl">
                        <span class="text-white font-semibold">Talent launches first.</span>
                        As partnerships deepen and demand grows, the Innovation, Market, and Civic Engines scale in alignment with regional development timelines.
                      </p>
                    </li>
                  )}
                </>
              ))}
            </ol>
          </nav>
        </div>
      </div>
    </div>
  </section>

  <!-- Wrapper limits the sticky bar to the engine sections; it scrolls away before Guiding Principles -->
  <div class="bg-white">
    <nav aria-label="Engines on this page" class="font-sans sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-navy/15">
      <div class="container">
        <ul class="flex gap-1 overflow-x-auto [scrollbar-width:none] -mx-2" role="list">
          {engines.map((engine, i) => (
            <li class="shrink-0">
              <a
                href={`#${engine.id}`}
                data-engine-link={engine.id}
                class="flex items-center gap-2 px-2 sm:px-3 py-3.5 border-b-2 border-transparent text-sm sm:text-base font-medium text-gray-dark hover:text-navy aria-[current=location]:border-navy aria-[current=location]:text-navy aria-[current=location]:font-semibold"
              >
                <span class="hidden sm:inline text-gray tabular-nums text-sm">{String(i + 1).padStart(2, '0')}</span>
                {engine.name.replace(' Engine', '')}
                <span class="sr-only"> Engine</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <!-- THE ENGINES: identical spec-sheet structure, so the four can be compared row by row.
         Orange = industry, lagoon = Civic (DESIGN.md). -->
    {engines.map((engine, i) => (
      <section id={engine.id} aria-labelledby={`${engine.id}-title`} class="scroll-mt-12">
        <div class="container pt-14 pb-16 md:pt-20 md:pb-24">
          <div class="grid gap-y-8 lg:grid-cols-12 lg:gap-x-8 border-t-2 border-navy pt-6 md:pt-8">

            <!-- LABEL COLUMN: index, name, what it transforms, launch position -->
            <header class="lg:col-span-4">
              <p class="font-sans text-sm text-gray tabular-nums flex items-center gap-2 mb-3">
                <span class:list={['w-2.5 h-2.5 rounded-full', engine.tone === 'lagoon' ? 'bg-lagoon' : 'bg-orange']} aria-hidden="true"></span>
                {String(i + 1).padStart(2, '0')}
              </p>
              <h2 id={`${engine.id}-title`} class="mb-4">{engine.name}</h2>
              <p class:list={['font-sans font-medium mb-0', engine.tone === 'lagoon' ? 'text-lagoon' : 'text-gray-dark']}>{engine.shift}</p>
              {engine.launchesFirst && (
                <p class="font-sans text-sm text-navy font-semibold mt-2 mb-0">Launches first</p>
              )}
            </header>

            <!-- CONTENT COLUMN -->
            <div class="lg:col-span-8">
              <p class="text-2xl text-navy leading-snug mb-10 max-w-3xl">{engine.summary.join(' ')}</p>

              <dl>
                <div class="grid gap-y-2 md:grid-cols-8 md:gap-x-8 border-t border-navy/15 py-5">
                  <dt class="md:col-span-2 font-sans text-sm font-semibold text-navy">Brings together</dt>
                  <dd class="md:col-span-6 font-sans text-gray-dark">{engine.together.join(' · ')}</dd>
                </div>

                <!-- The before/after pair: adjacent rows on the same axis -->
                <div class="grid gap-y-3 md:grid-cols-8 md:gap-x-8 border-t border-navy/15 py-5">
                  <dt class="md:col-span-2 font-sans text-sm font-semibold text-navy">What it solves</dt>
                  <dd class="md:col-span-6">
                    <ul class="flex flex-col gap-2" role="list">
                      {engine.solves.map((gap) => (
                        <li class="flex gap-3 leading-snug text-gray-dark">
                          <span class="mt-[0.6em] w-3 h-0.5 shrink-0 bg-gray/60" aria-hidden="true"></span>
                          {gap}
                        </li>
                      ))}
                    </ul>
                  </dd>
                </div>

                <div class="grid gap-y-3 md:grid-cols-8 md:gap-x-8 border-t border-navy/15 py-5">
                  <dt class="md:col-span-2 font-sans text-sm font-semibold text-navy">Regional impact</dt>
                  <dd class="md:col-span-6">
                    <ul class="flex flex-col gap-2" role="list">
                      {engine.impact.map((result) => (
                        <li class="flex gap-3 leading-snug text-navy">
                          <span class:list={['mt-[0.6em] w-3 h-0.5 shrink-0', engine.tone === 'lagoon' ? 'bg-lagoon' : 'bg-orange']} aria-hidden="true"></span>
                          {result}
                        </li>
                      ))}
                    </ul>
                  </dd>
                </div>

                <!-- The program catalogue: one column on the same axis; each item opens in place -->
                <div class="grid gap-y-1 md:grid-cols-8 md:gap-x-8 border-t border-navy/15 pt-5">
                  <dt class="md:col-span-2 font-sans text-sm font-semibold text-navy">
                    Components <span class="font-medium text-gray">· {engine.components.length}</span>
                  </dt>
                  <dd class="md:col-span-6 md:-mt-3">
                    <ul role="list">
                      {engine.components.map((item) => (
                        <li class="border-b border-navy/15 last:border-b-0">
                          <details class="group">
                            <summary class="flex items-start justify-between gap-4 py-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                              <span class="font-sans font-semibold text-navy leading-snug">{item.title}</span>
                              <svg class="w-5 h-5 mt-px shrink-0 text-navy transition-transform group-open:rotate-45" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M10 4v12M4 10h12" stroke-linecap="round" />
                              </svg>
                            </summary>
                            <p class="pb-5 pr-9 text-base text-gray-dark">{item.body}</p>
                          </details>
                        </li>
                      ))}
                    </ul>
                  </dd>
                </div>
              </dl>
            </div>
          </div>
        </div>
      </section>
    ))}
  </div>

  <!-- GUIDING PRINCIPLES: same label | content axes (Overview PDF p. 2, ⚠ Review) -->
  <section class="section bg-night text-white">
    <div class="container">
      <div class="grid gap-y-8 lg:grid-cols-12 lg:gap-x-8 border-t-2 border-white pt-6 md:pt-8">
        <h2 class="lg:col-span-4 text-white mb-0">Guiding Principles</h2>
        <div class="lg:col-span-8">
          <p class="font-display text-3xl md:text-4xl font-semibold text-white leading-tight mb-6">Partner-first, gap-filling, and coalition-driven.</p>
          <p class="text-2xl text-white/85 leading-snug mb-10 max-w-3xl">
            FSIC positions itself as a neutral convener that strengthens—not competes with—existing institutions by aligning talent, industry needs, and community priorities.
          </p>
          <ul role="list">
            <li class="border-t border-white/25 py-5 text-white/80">The strategy starts small, delivers visible early wins, and scales only when partners signal readiness.</li>
            <li class="border-y border-white/25 py-5 text-white/80">Every partnership is structured for low operational burden, high shared value, and clear governance.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CLOSING (Master Plan p. 11): statement and next steps on the content axis -->
  <section class="section bg-white">
    <div class="container grid gap-y-8 lg:grid-cols-12 lg:gap-x-8">
      <div class="lg:col-start-5 lg:col-span-8">
        <p class="font-display text-3xl md:text-4xl font-semibold text-navy leading-tight mb-10">
          This architecture ensures FSIC is not just a program—but a durable regional institution capable of driving workforce development, innovation, economic mobility, and civic cohesion for decades.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <Button href="/deployment">View the Deployment Timeline</Button>
          <Button href="/programs-facilities" variant="secondary">Explore Programs &amp; Facilities</Button>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  // Mark the engine currently in view in the sticky engine bar.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-engine-link]')].map((a) => [a.dataset.engineLink, a]),
  );
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((a) => a.removeAttribute('aria-current'));
        links.get(entry.target.id)?.setAttribute('aria-current', 'location');
      }
    },
    { rootMargin: '-40% 0px -55% 0px' },
  );
  links.forEach((_, id) => {
    const section = id && document.getElementById(id);
    if (section) observer.observe(section);
  });
</script>
