---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Grid from '../components/Grid.astro';
import Row from '../components/Row.astro';
import List from '../components/List.astro';
import { mailto } from '../lib/site';
import Disclosure from '../components/Disclosure.astro';
import HeroIndex from '../components/HeroIndex.astro';
import { pad2 } from '../lib/format';
import Closing from '../components/Closing.astro';
import { bodies, metrics, reportingCalendar } from '../data/governance';
import SectionBar from '../components/SectionBar.astro';
import { type PageSection, sectionProps, sectionBarItems } from '../lib/sections';

// Copy: src/content/copy/governance.md (Draft). Wording is verbatim from the copy deck.
// Not on the page until confirmed (see governance.md ⚠): board member names and the founder transition.


const sections: PageSection[] = [
  { id: 'backbone', name: 'A neutral backbone organization', short: 'Backbone' },
  { id: 'structure', name: 'Governance and organizational structure', short: 'Structure' },
  { id: 'reporting', name: 'Public reporting and transparency', short: 'Reporting' },
  { id: 'metrics', name: 'Key metrics and reporting cadence', short: 'Metrics' },
  { id: 'developers', name: 'The role of developers', short: 'Developers' },
];
const at = (id: string) => sectionProps(sections, id);

---
<BaseLayout title="Governance & Transparency" description="How the Florida Space Innovation Center is governed: an independent board, executive leadership, advisory councils, committees, public reporting and key metrics.">

  <!-- Interior page template (DESIGN.md): PageHero with an index of sections, narrative sections, closing -->
  <PageHero title="Governance & Transparency">
    <p class="text-lead text-white/90 mb-6">
      FSIC operates under a partner-first, coalition-driven governance structure.
    </p>
    <p class="text-white/75 mb-10 max-w-3xl">
      The Florida Space Innovation Center is designed with a governance model that ensures independence, transparency, accountability, and long-term institutional credibility. The structure reflects national best practices for nonprofit innovation hubs and aligns with expectations from philanthropic funders, state agencies, federal partners, and major employers.
    </p>

    <HeroIndex label="On this page" items={sections} />
  </PageHero>

  <!-- The wrapper bounds the sticky section bar to the numbered sections; it scrolls away before the closing -->
  <div>
    <SectionBar
      ariaLabel="Sections on this page"
      numbered
      items={sectionBarItems(sections)}
    />

  <!-- 01 · A NEUTRAL BACKBONE ORGANIZATION (fsic.space FAQ) -->
  <Section {...at('backbone')} heading="A Neutral Backbone Organization">
    <Grid>
      <p slot="label" class="mb-0 text-statement text-navy">
        FSIC's role is to coordinate, align, and accelerate — not duplicate.
      </p>
      <div class="max-w-3xl">
        <p>
          FSIC is a neutral backbone organization that coordinates the work of schools, colleges, universities, employers, and civic partners. It does not replace existing institutions — it strengthens them.
        </p>
        <p>
          FSIC fills gaps, aligns stakeholders, and builds the connective infrastructure that no single organization can create alone.
        </p>
        <p class="mt-8 pt-6 border-t border-rule mb-4">
          FSIC is intentionally designed to amplify, not compete with, existing institutions. It:
        </p>
        <List
          items={['Co-brands programs with partners', 'Shares credit, curriculum, and facilities', 'Strengthens enrollment in partner institutions', 'Builds pathways that benefit all stakeholders']}
          class="text-navy"
        />
      </div>
    </Grid>
  </Section>

  <!-- 02 · STRUCTURE: one row per governing body, its purpose visible and its lists opening in place (Master Plan pp. 15–17) -->
  <Section {...at('structure')} spacing="stacked" heading="Governance and Organizational Structure">
    <Grid>
      <p slot="label" class="mb-0 text-statement text-navy">
        The governance model ensures that no single individual, partner, or sector can dominate decision-making.
      </p>
      <div>
        <p class="max-w-3xl mb-10">
          FSIC's leadership model is intentionally broad. A cross-sector Board of Directors and a Multi-Institution Advisory Council — representing education, industry, workforce, civic, and government partners — will be featured on the FSIC website as they are formally seated. This structure ensures FSIC remains a neutral, community-anchored institution.
        </p>
        <dl>
          {bodies.map((body, i) => (
            <Row label={body.name} class={i === bodies.length - 1 ? 'border-b border-rule' : undefined}>
              <p class="mb-4">{body.purpose}</p>
              <div>
                {body.lists.map((list) => (
                  <Disclosure class="border-t border-rule" summaryClass="items-center gap-4 py-3">
                    <span slot="summary" class="text-label text-navy">{list.label}<span class="font-medium text-gray"> · {list.items.length}</span></span>
                    <List items={list.items} class="pb-4 text-gray-dark" />
                  </Disclosure>
                ))}
                {body.duties && (
                  <Disclosure class="border-t border-rule" summaryClass="items-center gap-4 py-3">
                    <span slot="summary" class="text-label text-navy">{body.duties.label}<span class="font-medium text-gray"> · {body.duties.items.length}</span></span>
                    <List items={body.duties.items} class="pb-4 text-gray-dark" />
                  </Disclosure>
                )}
              </div>
            </Row>
          ))}
        </dl>
      </div>
    </Grid>
  </Section>

  <!-- 03 · PUBLIC REPORTING AND TRANSPARENCY (Master Plan pp. 17, 31) -->
  <Section {...at('reporting')} spacing="stacked" heading="Public Reporting and Transparency">
    <Grid>
      <p slot="label" class="mb-0 text-statement text-navy">
        Transparent reporting strengthens credibility, supports fundraising, and ensures FSIC remains accountable to the region it serves.
      </p>
      <div>
        <p class="max-w-3xl mb-10">
          The Florida Space Innovation Center is committed to rigorous evaluation, transparent reporting, and continuous improvement. The evaluation framework measures outcomes across workforce development, innovation, commercialization, and community engagement. This approach ensures accountability to funders, partners, and the public while enabling data-driven decision-making and long-term impact.
        </p>
        <dl>
          <Row label="Public reporting">
            <List items={['Annual Impact Report', "Public dashboards on FSIC's website", 'Community presentations and exhibitions', 'Grant-specific reporting for funders', 'Regular updates to local governments and partners']} class="text-gray-dark" />
          </Row>
          <Row label="Compliance">
            <List items={['Annual audits', 'Conflict-of-interest disclosures', 'Public reporting and transparency', 'Grant compliance and reporting', 'Ethical fundraising policies']} class="text-gray-dark" />
          </Row>
          <Row label="Evaluation principles" class="border-b border-rule">
            <List items={['Measure what matters most to employers, educators, funders, and the community', 'Use data to drive continuous improvement', 'Report outcomes transparently and consistently', 'Align metrics with state and federal funding requirements', 'Demonstrate clear return on investment']} class="text-gray-dark" />
          </Row>
        </dl>
      </div>
    </Grid>
  </Section>

  <!-- 04 · METRICS (Master Plan pp. 31–32): one row per area, its metrics one per line; then the
       reporting calendar, every area's reports grouped by frequency (derived in src/data/governance.ts) -->
  <Section
    {...at('metrics')}
    spacing="stacked"
    heading="Key Metrics and Reporting Cadence"
    intro="FSIC's evaluation framework is designed to be comprehensive, transparent, and aligned with national best practices for workforce and innovation ecosystems."
  >
    <div class="border-t-2 border-navy">
      {metrics.map((m) => (
        <div class="grid gap-y-3 py-6 border-b border-rule lg:grid-cols-12 lg:gap-x-8">
          <h3 class="lg:col-span-4 lg:self-start mb-0 text-xl flex items-center gap-2">
            <span class:list={['w-2.5 h-2.5 shrink-0 rounded-full', m.tone === 'lagoon' ? 'bg-lagoon' : m.tone === 'orange' ? 'bg-orange' : 'bg-transparent']} aria-hidden="true"></span>
            <span class="w-6 shrink-0 text-caption text-gray tabular-nums font-normal">{m.number !== null ? pad2(m.number) : ''}</span>
            {m.name}
          </h3>
          <div class="lg:col-span-8 lg:pt-1">
            <p class="sr-only">Key metrics</p>
            <List items={[...m.items]} class="text-gray-dark" />
          </div>
        </div>
      ))}
    </div>

    <Grid class="mt-16">
      <div slot="label">
        <h3 class="text-xl mb-2">Reporting calendar</h3>
        <p class="mb-0 text-caption text-gray-dark">Every area's reports, by how often they come out.</p>
      </div>
      <dl>
        {reportingCalendar.map((group, i) => (
          <Row label={group.frequency} rule="bottom" class={i > 0 ? 'pt-5' : undefined}>
            <List
              html
              items={group.reports.map((r) => `${r.report} <span class="block sm:inline text-caption text-gray leading-snug whitespace-nowrap"><span class="hidden sm:inline">· </span>${r.area}</span>`)}
              class="text-navy"
            />
          </Row>
        ))}
      </dl>
    </Grid>
  </Section>

  <!-- 05 · THE ROLE OF DEVELOPERS (fsic.space FAQ): the trust statement, on night -->
  <Section {...at('developers')} dark heading="What Is the Role of Developers?">
    <Grid>
      <p slot="label" class="mb-0 text-statement text-white">
        Developers play a collaborative — not controlling — role in FSIC's work.
      </p>
      <div class="max-w-3xl text-white/90">
        <p>
          FSIC is an independent, community-aligned organization, and we recognize that many residents value slow growth or prefer no additional growth at all. Large developments in the region have already been approved, and FSIC does not influence or promote those decisions.
        </p>
        <p>
          Our role is to help ensure that what happens within that approved growth reflects community priorities by steering opportunities toward high-wage, future-focused industries rather than low-value or high-impact uses. Developers may help create spaces that support training, innovation, and community engagement, but FSIC does not endorse specific projects or drive development.
        </p>
        <p>
          Our focus is protecting community character while shaping the future economy in ways that benefit the people who already live here.
        </p>
      </div>
    </Grid>
  </Section>
  </div>

  <!-- CLOSING (home.md). "Contact FSIC" opens an email until the Contact page has a form. -->
  <Closing statement="Neutral convener. Clear structure. Long-term accountability.">
    <Button href="/partnership-funding">Become a Partner</Button>
    <Button href={mailto()} variant="secondary">Contact FSIC</Button>
  </Closing>

</BaseLayout>
