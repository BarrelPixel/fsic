---
import { Image } from 'astro:assets';
import conceptImage from '../assets/fsic-concept.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import PageHero from '../components/PageHero.astro';
import HeroIndex from '../components/HeroIndex.astro';
import Section from '../components/Section.astro';
import Grid from '../components/Grid.astro';
import Row from '../components/Row.astro';
import List from '../components/List.astro';
import Closing from '../components/Closing.astro';
import SectionBar from '../components/SectionBar.astro';
import { type PageSection, sectionProps, sectionBarItems } from '../lib/sections';

// Copy: src/content/copy/long-term-vision.md (Draft). Master Plan pp. 36–38, framed by the FAQ's caveat.
// The Master Plan names the development throughout; the page says "Southeast Volusia" instead and
// leaves out the line about the family's legacy (docs/08 §3.3). Period: 2032–2040 (project lead).

const sections: PageSection[] = [
  { id: 'consortium', name: 'The Multi-University Consortium & Shared Facilities', short: 'Consortium' },
  { id: 'performing-arts', name: 'A Performing Arts Center for the Space Coast', short: 'Performing arts' },
  { id: 'campus', name: 'A Landmark Campus for Southeast Volusia', short: 'Campus' },
];
const at = (id: string) => sectionProps(sections, id);
---
<BaseLayout title="Long-Term Vision" description="The long-term vision for the Florida Space Innovation Center, 2032–2040: a multi-university consortium, a performing arts center for the Space Coast, and a landmark campus for Southeast Volusia.">

  <!-- Interior page template (DESIGN.md): PageHero with the caveat as the aside and an index of the sections -->
  <PageHero title="The Long-Term Vision">
    <p slot="aside">
      <strong class="font-semibold text-white">2032–2040.</strong>
      While no outcomes are guaranteed, these concepts reflect the direction FSIC is planning toward, and we are building our partnerships, programs, and strategy to make these possibilities achievable.
    </p>
    <p class="text-lead text-white/90 mb-6 max-w-3xl">
      A Permanent, Multi-University, Cultural, and Innovation Anchor for the Space Coast
    </p>
    <p class="text-white/75 mb-10 max-w-3xl">
      The long-term vision for the Florida Space Innovation Center extends well beyond the 2026–2031 master plan. The early years establish credibility, partnerships, and momentum. The next decade transforms FSIC into a landmark institution — a place where education, research, culture, and community converge in a way that defines the Space Coast for generations.
    </p>
    <HeroIndex label="Page contents" size="large" items={sections} />
  </PageHero>

  <!-- The wrapper bounds the sticky section bar to the sections; it scrolls away before the closing -->
  <div>
    <SectionBar
      ariaLabel="Sections on this page"
      numbered
      items={sectionBarItems(sections)}
    />

  <!-- 01 · The consortium (Master Plan pp. 36–37) -->
  <Section {...at('consortium')} heading="The Multi-University Consortium & Shared Facilities">
    <Grid>
      <p slot="label" class="mb-0 text-statement text-navy">
        This is the moment when FSIC stops being a programmatic initiative and becomes a permanent academic and research institution.
      </p>
      <div>
        <p class="max-w-3xl mb-10">
          By the early 2030s, FSIC evolves into a formal multi-university consortium — a coordinated academic alliance modeled on the Houston Spaceport, the NSF Engines hubs, and major research collaboratives.
        </p>
        <dl>
          <Row label="Core elements" rule="bottom">
            <List items={[
              'Multiple universities with permanent physical presence',
              'Shared research labs, testing facilities, and applied R&D spaces',
              'Joint faculty appointments and rotating scholar-in-residence programs',
              'Cross-institutional degree pathways in aerospace, robotics, AI, materials, and systems engineering',
              'A unified governance and funding model that ensures independence and academic credibility',
            ]} class="text-gray-dark" />
          </Row>
          <Row label="Why this matters" rule="bottom" class="pt-5">
            <List items={[
              'It anchors Southeast Volusia as the intellectual center of the Space Coast',
              'It attracts faculty, researchers, graduate students, and industry partners',
              'It drives long-term economic development and employer retention',
              'It positions FSIC as a nationally recognized hub for space-industry talent and innovation',
            ]} class="text-navy" />
          </Row>
        </dl>
      </div>
    </Grid>
  </Section>

  <!-- 02 · The auditorium and performing arts center (Master Plan p. 37) -->
  <Section {...at('performing-arts')} spacing="stacked" heading="A Performing Arts Center for the Space Coast">
    <Grid>
      <p slot="label" class="mb-0 text-statement text-navy">
        The long-term plan includes a multi-purpose auditorium that serves dual roles.
      </p>
      <dl>
        <Row label="A functional asset for FSIC" rule="bottom">
          <List columns items={['Large-scale convenings', 'Industry summits', 'University consortium events', 'Public exhibitions', 'STEM showcases', 'Space-industry demonstrations']} class="text-gray-dark" />
        </Row>
        <Row label="A community-anchored Performing Arts Center" rule="bottom" class="pt-5">
          <p class="mb-3 text-gray-dark">This is where the vision becomes transformational. The auditorium evolves into a regional performing arts center offering:</p>
          <List columns items={['Concerts', 'Theater', 'Dance', 'Film festivals', 'Community arts programming', 'School performances', 'Cultural events tied to space, science, and innovation']} class="text-gray-dark" />
        </Row>
        <Row label="Why this matters" rule="bottom" class="pt-5">
          <List items={[
            'It gives Southeast Volusia a cultural anchor that elevates the entire community',
            'It becomes a gathering place for residents, families, and visitors',
            'It strengthens the Civic Engine and deepens community identity',
            'It positions FSIC as not just an innovation hub, but a cultural and civic destination',
          ]} class="text-navy" />
        </Row>
      </dl>
    </Grid>
  </Section>

  <!-- 03 · The landmark campus (Master Plan p. 38), with the concept rendering and its required caption -->
  <Section {...at('campus')} dark heading="A Landmark Campus for Southeast Volusia">
    <figure slot="media" class="relative">
      <Image
        src={conceptImage}
        alt="Concept rendering of a future campus: research buildings, a tower, and a glass dome set among wetlands, palms, and a boardwalk."
        widths={[640, 960, 1280, 1536]}
        sizes="100vw"
        class="w-full h-[50vh] min-h-[320px] max-h-[640px] object-cover"
      />
      <figcaption class="text-caption container text-white/60 pt-3">Concept rendering. Design and location to be determined.</figcaption>
    </figure>
    <Grid>
      <p slot="label" class="mb-0 text-statement text-white">
        This is the endgame: a place where innovation, education, and culture converge — financed through state tools, supported by the community, and anchored by a multi-university presence.
      </p>
      <div>
        <p class="max-w-3xl mb-10 text-white/90">
          By the mid-2030s, FSIC becomes a signature campus — a place that people recognize instantly.
        </p>
        <dl>
          <Row label="Campus elements" rule="bottom" dark>
            <List items={[
              'The multi-university research complex',
              'The performing arts center',
              'The innovation labs and testing facilities',
              'The Talent Engine pavilion',
              'Public plazas, green spaces, and community gathering areas',
              "A visible architectural identity that symbolizes the Space Coast's future",
            ]} class="text-white/75" />
          </Row>
          <Row label="What this achieves" rule="bottom" dark class="pt-5">
            <List items={[
              'A permanent anchor that drives foot traffic, economic activity, and cultural life',
              'A destination that attracts families, employers, and visitors',
              'A regional hub that positions Southeast Volusia as a leader in space-industry innovation and education',
            ]} class="text-white/90" />
          </Row>
        </dl>
      </div>
    </Grid>
  </Section>
  </div>

  <Closing statement="The future is built in phases. The commitment begins now.">
    <Button href="/partnership-funding">Become a Partner</Button>
    <Button href="/deployment" variant="secondary">View Phased Deployment</Button>
  </Closing>

</BaseLayout>
