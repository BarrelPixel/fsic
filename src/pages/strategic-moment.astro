---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Grid from '../components/Grid.astro';
import Row from '../components/Row.astro';
import List from '../components/List.astro';
import Closing from '../components/Closing.astro';
import HeroIndex from '../components/HeroIndex.astro';
import SectionBar from '../components/SectionBar.astro';
import { type PageSection, sectionProps, sectionBarItems } from '../lib/sections';
import { url } from '../lib/url';
import { stakes } from '../data/strategic';

// Copy: src/content/copy/strategic-moment.md (Draft). Sections are verbatim from fsic.space/about-4,
// except the lead (Master Plan p. 4) and the development figures (Master Plan pp. 4 and 6, unnamed:
// the site does not name the development, docs/08 §3.3).

const sections: PageSection[] = [
  { id: 'inflection-point', name: 'A Region at an Inflection Point', short: 'Inflection point' },
  { id: 'place-based-innovation', name: 'A National Shift Toward Place-Based Innovation', short: 'Place-based innovation' },
  { id: 'catalyst', name: 'A Once-in-a-Generation Catalyst', short: 'Catalyst' },
  { id: 'window', name: 'The Window Is Open', short: 'The window' },
];
const at = (id: string) => sectionProps(sections, id);

const capacity = ['workforce development', 'applied research', 'entrepreneurship', 'enabling infrastructure', 'cross-sector governance'];

const figures = [
  { value: 'More than 10,000', measure: 'homes' },
  { value: 'Over 10 million', measure: 'square feet of industrial and commercial space' },
];
---
<BaseLayout title="The Strategic Moment" description="Southeast Volusia is entering one of the most consequential economic windows in its modern history. Why the Florida Space Innovation Center is needed now.">

  <!-- Interior page template (DESIGN.md): PageHero, four narrative sections, closing -->
  <PageHero title="Why Now — The Strategic Moment">
    <p class="text-lead text-white/90 mb-10">
      Southeast Volusia is entering one of the most consequential economic windows in its modern history.
    </p>
    <HeroIndex label="Page contents" size="large" items={sections} />
  </PageHero>

  <!-- The wrapper bounds the sticky section bar to the sections; it scrolls away before the closing -->
  <div>
    <SectionBar
      ariaLabel="Sections on this page"
      numbered
      items={sectionBarItems(sections)}
    />

  <!-- 01 · Narrative: the consequence as the thesis (cols 1–4), the situation (cols 5–12) -->
  <Section {...at('inflection-point')} heading="A Region at an Inflection Point">
    <Grid>
      <p slot="label" class="mb-0 text-statement text-navy">
        Without intervention, we risk absorbing population growth without gaining the high-wage jobs and employer investment that should accompany it.
      </p>
      <div class="max-w-3xl">
        <p>
          The Space Coast is now the busiest launch corridor in the world, with commercial, civil, and defense missions driving rapid expansion in spacecraft manufacturing, robotics, autonomy, and dual-use technologies.
        </p>
        <p class="mb-0">
          Yet Southeast Volusia lacks the coordinated systems needed to capture this opportunity.
        </p>
      </div>
    </Grid>
  </Section>

  <!-- 02 · Narrative: the five areas of capacity as a list, as in the Master Plan (p. 4) -->
  <Section {...at('place-based-innovation')} spacing="stacked" heading="A National Shift Toward Place-Based Innovation">
    <Grid>
      <p slot="label" class="mb-0 text-statement text-navy">
        Southeast Volusia can fill that gap — but only if we organize now.
      </p>
      <div class="max-w-3xl">
        <p>
          Federal and state policy is moving decisively toward regional innovation ecosystems. <a href={url('/partnership-funding#funding')} class="link">Billions in funding</a> — CHIPS and Science Act, EDA Tech Hubs, NSF Engines, and state programs — are flowing to regions that can demonstrate coordinated capacity across:
        </p>
        <List items={capacity} class="mb-6 text-gray-dark" />
        <p class="mb-0">
          The Space Coast has no <a href={url('/model#innovation')} class="link">civilian-facing innovation hub</a> capable of competing for these investments.
        </p>
      </div>
    </Grid>
  </Section>

  <!-- 03 · The catalyst on night: the figures, introduced by the first half of the sentence (cols 1–4); the
       consequence and the before/after pair as
       adjacent rows on one axis (Master Plan pp. 4 and 6; the development is not named) -->
  <Section {...at('catalyst')} dark heading="Southeast Volusia County: A Once-in-a-Generation Catalyst">
    <Grid>
      <div slot="label">
        <p class="mb-5 font-sans text-white/75">A master-planned development in Southeast Volusia will add:</p>
        <dl class="space-y-6">
          {figures.map((f) => (
            <div>
              <dt class="font-display text-3xl md:text-4xl font-bold leading-tight text-white">{f.value}</dt>
              <dd class="mt-1 font-sans text-white/75">{f.measure}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-6 mb-0 text-caption text-white/60">Source: FSIC Master Plan 2026–2031, pp. 4 and 6.</p>
      </div>
      <div>
        <p class="max-w-3xl text-white/90 mb-10">
          This growth will reshape the region's workforce needs, employer mix, and <a href={url('/economic-impact#risks-opportunities')} class="link-on-dark">long-term economic trajectory</a>.
        </p>
        <dl>
          <Row label={stakes.without.label} rule="bottom" dark dot="gray">
            <List items={stakes.without.items} class="text-white/75" />
          </Row>
          <Row label={stakes.with.label} rule="bottom" dark dot="lagoon" class="pt-5">
            <List items={stakes.with.items} class="text-white" />
          </Row>
        </dl>
      </div>
    </Grid>
  </Section>

  <!-- 04 · The two possible outcomes, then FSIC's role -->
  <Section {...at('window')} heading="The Window Is Open — But Not for Long">
    <Grid>
      <p slot="label" class="mb-0 text-statement text-navy">
        The next five years will determine whether Southeast Volusia becomes:
      </p>
      <div class="max-w-3xl">
        <List items={["a full participant in the Space Coast's next decade of growth, or", 'a region that watches opportunity flow past it']} spacious class="mb-8 font-display text-2xl font-semibold text-navy" />
        <p class="mb-0">
          FSIC is designed to meet this moment. It provides the coordinated talent, innovation, commercialization, and civic infrastructure required to compete for high-value jobs, federal investment, and long-term economic mobility.
        </p>
      </div>
    </Grid>
  </Section>
  </div>

  <!-- CLOSING: the callout as the statement, next steps on the content axis -->
  <Closing statement="FSIC transforms fragmented potential into coordinated progress. It ensures that opportunity flows into Southeast Volusia — not past it.">
    <Button href="/model">Explore the FSIC Model</Button>
    <Button href="/economic-impact" variant="secondary">View Economic Impact</Button>
  </Closing>

</BaseLayout>
