---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Grid from '../components/Grid.astro';
import Row from '../components/Row.astro';
import List from '../components/List.astro';
import { engines } from '../data/programs';
import ProgramList from '../components/ProgramList.astro';
import HeroIndex from '../components/HeroIndex.astro';
import Closing from '../components/Closing.astro';
import { phases as phaseData } from '../data/phases';

// Copy: src/content/copy/programs-facilities.md (Draft). Audiences: fsic.space FAQ (verbatim). Portfolio
// (src/data/programs.ts, shared with the Model page):
// Master Plan pp. 19–21. Facilities: FAQ (status) and Master Plan pp. 17–19, without the named
// development (docs/08 §3.3).

const base = import.meta.env.BASE_URL;

const sections = [
  { id: 'audiences', name: 'Programs by Audience' },
  { id: 'portfolio', name: 'Program Portfolio and Core Offerings' },
  { id: 'facilities', name: 'Facilities and Infrastructure Plan' },
];

const audiences = [
  { label: 'For students and families', items: ['Hands-on STEM learning and maker experiences', 'Dual-enrollment pathways', 'Micro-credentials tied to real jobs', 'Community STEM and arts events'] },
  { label: 'For adults and career-switchers', items: ['Short, employer-validated training programs', 'Job placement, apprenticeships, and upskilling', 'Clear pathways into high-wage technical careers'] },
  { label: 'For the community', items: ['Higher wages and economic mobility', 'A stronger regional identity tied to innovation', 'More opportunities for youth and families to engage in STEM'] },
];

const principles = [
  'Flexible, modular spaces that adapt to evolving needs',
  'Co-location of education, industry, and community functions',
  'Accessibility for students, educators, employers, and residents',
  'Cost-effective phased build-out aligned with funding and demand',
  'Spaces that inspire creativity, collaboration, and civic pride',
];

// Planned core spaces per phase (src/data/phases.ts, shared with Deployment).
const phases = phaseData.map((p, i) => ({ n: i + 1, name: p.name, when: p.timeframe, spaces: p.spaces }));

const link = 'link';
---
<BaseLayout title="Programs & Facilities" description="FSIC's programs for students, adults, businesses, and the community, the program portfolio across the Talent, Innovation, Market, and Civic Engines, and the phased facilities plan.">

  <!-- Interior page template (DESIGN.md): PageHero with an index of the three sections -->
  <PageHero title="Programs & Facilities">
    <p class="text-lead text-white/90 mb-10 max-w-3xl">
      FSIC expands opportunity for residents of all ages by making the space economy accessible and visible.
    </p>
    <HeroIndex label="Sections on this page" size="large" items={sections} />
  </PageHero>

  <!-- 01 · Programs by audience: who each set of programs is for (FAQ, verbatim) -->
  <Section id="audiences" index={1} total={3} heading="Programs by Audience" class="scroll-mt-12">
    <Grid>
      <Fragment slot="label"></Fragment>
      <dl>
        {audiences.map((a, i) => (
          <Row label={`${a.label}:`} rule="bottom" class={i > 0 ? 'pt-5' : undefined}>
            <List items={a.items} class="text-gray-dark" />
          </Row>
        ))}
        <Row label="For businesses and entrepreneurs:" rule="bottom" class="pt-5">
          <p class="mb-4 text-gray-dark">FSIC helps small businesses and startups participate in aerospace and advanced manufacturing supply chains — opportunities that are currently difficult to access.</p>
          <p class="mb-2 text-label text-navy">Support includes:</p>
          <List items={['Supplier-readiness bootcamps', 'Certification and contracting navigation', 'SBIR/STTR proposal support', 'Startup incubation and acceleration', 'Access to prototyping labs and applied research partners']} class="mb-4 text-gray-dark" />
          <p class="mb-0 text-gray-dark">This creates a pipeline of supplier-ready companies capable of competing in high-value markets.</p>
        </Row>
      </dl>
    </Grid>
  </Section>

  <!-- 02 · Program portfolio (Master Plan pp. 19–21): one row per engine, each program opening in
       place (+ turns to ×), and a link to that engine on the Model page -->
  <Section
    id="portfolio"
    index={2}
    total={3}
    spacing="stacked"
    heading="Program Portfolio and Core Offerings"
    intro="The Florida Space Innovation Center delivers a comprehensive portfolio of programs across the Talent, Innovation, Market, and Civic Engines. Each offering is designed to meet a specific regional need, align with employer demand, and create measurable impact for students, educators, businesses, and the community."
    class="scroll-mt-12"
  >
    <Grid>
      <Fragment slot="label"></Fragment>
      <dl>
        {engines.map((e, i) => (
          <Row label={e.name} count={e.programs.length} rule="bottom" class={i > 0 ? 'pt-5' : undefined}>
            <p class="mb-3 text-gray-dark">{e.line}</p>
            <ProgramList programs={e.programs} class="border-t border-rule" />
            <p class="mt-3 mb-0 text-caption">
              <a href={`${base}/model#${e.id}`} class={link}>The {e.name} on the Model page</a>
            </p>
          </Row>
        ))}
      </dl>
    </Grid>
  </Section>

  <!-- 03 · Facilities (FAQ and Master Plan pp. 17–19): today's status as the thesis, then the plan,
       the principles and the planned core spaces by phase. No development is named (docs/08 §3.3). -->
  <Section id="facilities" index={3} total={3} spacing="stacked" heading="Facilities and Infrastructure Plan" class="scroll-mt-12">
    <Grid>
      <p slot="label" class="mb-0 text-statement text-navy">
        FSIC is a virtual organization located in New Smyrna Beach.
      </p>
      <div>
        <div class="max-w-3xl">
          <p>
            A specific future site in Volusia County will be determined through a collaborative process with community members, civic leaders, industry partners, and other stakeholders. This ensures the final location reflects community priorities, long-term economic strategy, and the needs of partners.
          </p>
          <p class="mb-10">
            FSIC's facilities strategy is designed to scale with regional demand and support the phased deployment of the Talent, Innovation, Market, and Civic Engines. The infrastructure plan emphasizes flexibility, cost efficiency, and the creation of spaces that foster collaboration, hands-on learning, applied research, and community engagement.
          </p>
        </div>
        <dl>
          <Row label="Guiding principles" rule="bottom">
            <List items={principles} class="text-gray-dark" />
          </Row>
          {phases.map((ph) => (
            <Row label={`Phase ${ph.n} · ${ph.when}`} rule="bottom" class="pt-5">
              <p class="mb-2 font-sans font-semibold text-navy">{ph.name}</p>
              <p class="mb-2 text-caption text-gray-dark">Planned core spaces:</p>
              <List items={ph.spaces} class="text-gray-dark" />
            </Row>
          ))}
        </dl>
        <p class="mt-6 mb-0 text-caption">
          Each phase's activities and outcomes are on the <a href={`${base}/deployment`} class={link}>Phased Deployment</a> page.
        </p>
      </div>
    </Grid>
  </Section>

  <!-- CLOSING: statement and next steps on the content axis -->
  <Closing statement="The program portfolio is intentionally modular and scalable, enabling FSIC to grow responsibly while maintaining high quality and strong outcomes.">
    <Button href="/partnership-funding">Get Involved</Button>
    <Button href="/contact" variant="secondary">Contact FSIC</Button>
  </Closing>

</BaseLayout>
