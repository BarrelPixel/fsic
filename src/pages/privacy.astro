---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Grid from '../components/Grid.astro';
import List from '../components/List.astro';
import { EMAIL, mailto, ORG } from '../lib/site';

// Copy: src/content/copy/privacy.md (Draft). It says only what the site does today; when the site changes
// (analytics, a form, a newsletter, donations), the copy changes first. Kept out of search and out of the footer
// until FSIC and its counsel approve it.
---
<BaseLayout title="Privacy Policy" description="What the Florida Space Innovation Center's website collects, and what FSIC does with it." noindex>

  <PageHero title="Privacy Policy">
    <p slot="aside">
      Last updated November 10, 2026. Questions: <a href={mailto('Privacy')} class="link-on-dark">{EMAIL}</a>.
    </p>
    <p class="text-lead text-white/90 mb-0">What this website collects, and what FSIC does with it.</p>
  </PageHero>

  <Section heading="What the Site Collects">
    <Grid>
      <p slot="label" class="mb-0 text-statement text-navy">In short: very little.</p>
      <div class="max-w-3xl">
        <List
          spacious
          html
          items={[
            '<strong class="text-navy">No cookies.</strong> The site sets no cookies and has no accounts or sign-ins.',
            `<strong class="text-navy">No forms.</strong> The site has no contact, newsletter or donation forms. To reach FSIC, you email ${EMAIL}.`,
            '<strong class="text-navy">No analytics, for now.</strong> The site doesn’t measure visits. If FSIC adds website analytics, this policy will name the service and what it collects before it’s turned on.',
            '<strong class="text-navy">No outside services on our pages.</strong> The site’s fonts and images are served from the site itself, so reading a page doesn’t send your information to other companies.',
            '<strong class="text-navy">Server logs.</strong> Like any website, the site’s host keeps standard server logs, which include visitors’ IP addresses, for security and to keep the site running.',
          ]}
        />
      </div>
    </Grid>
  </Section>

  <Section spacing="stacked" heading="When You Email FSIC">
    <Grid>
      <Fragment slot="label"></Fragment>
      <div class="max-w-3xl">
        <p>
          When you email <a href={mailto()} class="link">{EMAIL}</a>, FSIC uses your name, address and message to reply and to follow up on what you asked about. FSIC doesn’t sell or rent your information, and shares it only when you ask us to (for example, to connect you with a partner) or when the law requires it.
        </p>
        <p class="mb-0">To ask what FSIC holds about you, or to have it corrected or deleted, email {EMAIL}.</p>
      </div>
    </Grid>
  </Section>

  <Section spacing="stacked" heading="Links, Children and Changes">
    <Grid>
      <Fragment slot="label"></Fragment>
      <div class="max-w-3xl">
        <p>
          <strong class="text-navy">Links to other sites.</strong> The site links to other websites, such as FSIC’s LinkedIn, Facebook and X pages and the IRS’s search for tax-exempt organizations. Those sites have their own privacy policies.
        </p>
        <p>
          <strong class="text-navy">Children.</strong> The site doesn’t collect information from anyone, including children. Programs for students will have their own notices, with parents’ consent where required.
        </p>
        <p>
          <strong class="text-navy">Changes.</strong> When this policy changes, the date at the top changes. Significant changes, such as adding analytics or a form, are made here before they take effect on the site.
        </p>
        <p class="mb-0 text-caption text-gray-dark">{ORG.legalName}, New Smyrna Beach, Florida. {EMAIL}.</p>
      </div>
    </Grid>
  </Section>

</BaseLayout>
