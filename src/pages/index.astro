---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import Grid from '../components/Grid.astro';
import Row from '../components/Row.astro';
import List from '../components/List.astro';

import heroImage from '../assets/fsic-hero.png';
import ConceptRendering from '../components/ConceptRendering.astro';
import { pad2 } from '../lib/format';
import { sectionProps } from '../lib/sections';
import { FIGURES, SOURCE } from '../data/economics';
import { engines } from '../data/engines';
import { faqs } from '../data/faq';
import { phases } from '../data/phases';
import RangeBarsDraw from '../components/RangeBarsDraw.astro';
import RangeBar from '../components/RangeBar.astro';
import RangeLegend from '../components/RangeLegend.astro';
import { url } from '../lib/url';
import { getReleases, formatDate, isoDate, releaseHref } from '../lib/news';
import { SOCIAL_LINKS } from '../lib/site';
import Dot from '../components/Dot.astro';

// 25-year projections, Master Plan pp. 7–8 (src/data/economics.ts). Always show the full range (docs/08 §3.2).
const impact = [
  { label: 'Total economic output', ...FIGURES.output },
  { label: 'Job-years across aerospace, engineering, advanced manufacturing, and technology', ...FIGURES.jobYears },
  { label: 'New wages for Florida workers', ...FIGURES.wages },
  { label: 'Fiscal revenue for local and state governments', ...FIGURES.fiscal },
];

// The share image (og:image, twitter:image): the hero photo, 1200px wide (docs/10-homepage-plan.md A1).
const shareImage = await getImage({ src: heroImage, width: 1200, format: 'jpg' });

// The numbered sections in page order: their running heads (01 / 06…) follow this list. The argument runs
// why → how big → what → when, then the proof that FSIC is underway (docs/10-homepage-plan.md A2–A4).
const sections = ['strategic-moment', 'economic-impact', 'model', 'deployment', 'news', 'vision'].map((id) => ({ id }));
const at = (id: string) => sectionProps(sections, id);

// The three newest press releases (src/content/news/), as published.
const latest = (await getReleases()).slice(0, 3);

// Residents' common questions, linking to their answers on /faq (questions as published there).
const commonQuestions = ['residents-and-families', 'compete', 'funding', 'location'].map((id) => {
  const f = faqs.find((faq) => faq.id === id);
  if (!f) throw new Error(`index.astro: no FAQ question "${id}"`);
  return f;
});

// Where You Fit (plan B2): each audience, what it does with FSIC, and where to read more: the stakeholder
// rows on Partnership & Funding (src/data/partnership.ts ids), and for residents the programs by audience.
// Lines summarize those pages (home.md). Residents are the community, so their link is lagoon.
const fit = [
  { label: 'Employers', line: 'Validate curriculum, host internships and apprenticeships, and shape a local talent pipeline.', link: 'How employers take part', href: '/partnership-funding#employers' },
  { label: 'University leaders', line: 'Co-develop pathways, collaborate on applied research, and pursue joint federal funding.', link: 'How universities take part', href: '/partnership-funding#higher-ed' },
  { label: 'Policymakers', line: "Align economic development, infrastructure, and grant applications with the region's growth.", link: 'How local government takes part', href: '/partnership-funding#local-government' },
  { label: 'Workforce partners', line: 'Bring labor market data and employer engagement into one regional strategy.', link: 'How workforce agencies take part', href: '/partnership-funding#workforce-agencies' },
  { label: 'Residents and families', line: 'Hands-on STEM learning, dual-enrollment pathways, and micro-credentials tied to real jobs.', link: 'Programs for residents', href: '/programs-facilities#audiences', community: true },
];

// The people appointed so far (plan B4), as FSIC's releases announced them, each linking to its release.
// Roles are the release headlines' (home.md; titles to be confirmed, docs/07 "Titles").
const people = [
  { group: 'Board of Directors', members: [
    { name: 'Jessie Thompson', role: 'School Board Member', slug: '2026-07-07-jessie-thompson-joins-board' },
    { name: 'Diezel DePew', role: 'Mayor of Edgewater', slug: '2026-07-13-diezel-depew-joins-board' },
    { name: 'Ryan Trine', role: 'CEO of R3Doubt', slug: '2026-07-29-ryan-trine-joins-board' },
  ] },
  { group: 'Founders Council', members: [
    { name: 'Jake Johansson', role: '', slug: '2026-08-03-jake-johansson-joins-founders-council' },
  ] },
];
---
<BaseLayout title="Florida Space Innovation Center" image={shareImage.src}>

  <!--
    GRID (DESIGN.md "Grid"): one 12-column grid. Label column = cols 1–4, content column = cols 5–12.
    Sections use <Section> (running head, heavy rule, headline) and <Grid> (label | content).
    Copy is verbatim from src/content/copy/home.md.
  -->

  <!-- HERO: the launch photo.
       Phones (below md): the photo is a band across the top, undimmed and cropped to the plume, with
       its full height (plume tip to dunes); the text follows on night, the headline's whole first line
       sitting on the photo (48px). Only the photo's bottom third darkens toward night, so that line
       stays readable while the upper sky and plume stay undimmed.
       Phones, on scroll (CSS only, no JS, no animation): the photo and the night below it are pinned
       (sticky) while the text scrolls up over them. The text carries its own night backing, fading in
       just above the headline, so it rises over the photo like a sheet and every line stays on dark
       (6.2:1 or better at every scroll position, 320 and 390px). After the hero, the rest of the page
       slides up over the pinned layer.
       md and up: the photo always shows its full height (plume tip to dunes), anchored right, never
       cropped at the top; on screens wider than the photo, its left edge fades into night under the
       text. The text sits over the sky on the left; a night gradient keeps it readable (left to right
       on lg, top to bottom at md). -->
  <section class="relative bg-night text-white overflow-clip md:overflow-hidden">
    <!-- Phones: the photo and the night below it are one layer, a screen tall, pinned while the text scrolls over it -->
    <div class="sticky top-0 h-svh -mb-[100svh] md:static md:h-auto md:mb-0">
    <div class="relative md:static">
      <Image
        src={heroImage}
        alt="A rocket's exhaust plume climbs into a clear sky above the ocean, seen from the dunes along the coast."
        widths={[1440]}
        sizes="1440px"
        loading="eager"
        fetchpriority="high"
        class="hero-photo block w-full h-[max(46svh,62.5vw)] min-h-64 object-cover object-[78%_center] md:absolute md:right-0 md:top-0 md:h-full md:min-h-0 md:w-auto md:max-w-none"
      />
      <div class="md:hidden absolute inset-x-0 bottom-0 h-1/3 bg-linear-to-b from-night/0 via-night/70 via-55% to-night/90" aria-hidden="true"></div>
    </div>
    </div>
    <div class="hidden md:block absolute inset-0 bg-linear-to-b from-night/90 via-night/80 to-night/50 lg:bg-linear-to-r lg:from-night/90 lg:via-night/65 lg:via-45% lg:to-night/0 lg:to-75%" aria-hidden="true"></div>
    <div class="relative z-10 max-md:bg-[linear-gradient(to_bottom,transparent_calc(max(46svh,62.5vw,16rem)-6.5rem),var(--color-night)_calc(max(46svh,62.5vw,16rem)+1rem))]">
    <div class="relative container pt-[calc(max(46svh,62.5vw,16rem)-3rem)] pb-14 md:pt-24 md:pb-48 lg:pb-56 grid lg:grid-cols-12 lg:gap-x-8">
      <div class="lg:col-span-6 max-w-2xl">
        <h1 class="text-white mb-8">Opportunity That Flows Into Southeast Volusia — Not Past It</h1>
        <p class="md:text-lead text-white/90 mb-8 md:mb-10">
          The Florida Space Innovation Center is a coordinated regional platform for workforce, innovation, and industry growth, so that the Space Coast's expansion directly benefits the people who live and work here.
        </p>
        <div class="flex flex-wrap gap-4">
          <Button href="/partnership-funding" variant="primary">Get Involved</Button>
          <Button href="/economic-impact" variant="secondary-light">View Economic Impact</Button>
        </div>
      </div>
    </div>
    </div>
    <!-- Phones: keeps the photo pinned until the next section has covered it -->
    <div class="h-svh md:hidden" aria-hidden="true"></div>
  </section>

  <!-- Phones: the rest of the page slides up over the pinned hero photo (pulled up by the hero spacer's height) -->
  <div class="relative z-10 bg-white max-md:-mt-[100svh]">

  <!-- WHERE YOU FIT (plan B2): unnumbered, like the hero and the close. Each audience is a Row: who |
       what they do with FSIC and a link to their part of the site. -->
  <Section heading="Where You Fit">
    <Grid>
      <p slot="label" class="mb-0 text-statement text-navy">FSIC is a coordinated platform. Each part of the region has a role in it.</p>
      <dl class="max-w-3xl">
        {fit.map((a, i) => (
          <Row label={a.label} rule="bottom" class={i > 0 ? 'pt-5' : undefined}>
            <p class="mb-1">{a.line}</p>
            <a href={url(a.href)} class:list={['font-sans font-semibold', a.community ? 'link-lagoon' : 'link']}>{a.link}</a>
          </Row>
        ))}
      </dl>
    </Grid>
  </Section>

  <!-- 01 THE STRATEGIC MOMENT: opens with the founding parallel (moved from the hero, plan B1) -->
  <Section {...at('strategic-moment')} label="The strategic moment" spacing="stacked">
    <Fragment slot="heading">
      The Question Is Not Whether the Space Coast Will Grow.
      <span class="block mt-3 font-medium text-gray-dark">It Is Whether Southeast Volusia Will Participate in That Growth.</span>
    </Fragment>
    <Grid>
      <p slot="label" class="mb-0 text-statement text-navy">Without coordination, growth concentrates elsewhere.</p>
      <div class="max-w-3xl">
        <p>
          On May 25, 1961, the United States committed to landing a man on the Moon — not because it was easy, but because it demanded coordination, capability, and national resolve.
        </p>
        <p>
          Sixty-five years later, on the same date, <a href={url('/news/2026-05-25-fsic-launches-on-may-25')} class="link">Southeast Volusia launched</a> its own coordinated commitment: the Florida Space Innovation Center.
        </p>
        <p>
          Florida's space economy is expanding rapidly — driven by commercial launch activity, advanced manufacturing, aerospace engineering, and emerging technologies.
        </p>
        <p>
          The Florida Space Innovation Center (FSIC) ensures that Southeast Volusia is not a spectator to that growth, but an active participant — building the talent, infrastructure, and partnerships required to compete in a global innovation economy.
        </p>
        <p class="mt-8 pt-6 border-t border-rule text-navy font-medium">
          FSIC is designed to align education, industry, and community in one coordinated regional platform.
        </p>
        <Button href="/strategic-moment" variant="secondary">Explore the Strategic Moment</Button>
      </div>
    </Grid>
  </Section>

  <!-- 02 THE ECONOMIC CASE: a table on the page grid. Figure (cols 1–4) | what it measures (5–8) | range bar (9–12) -->
  <Section
    {...at('economic-impact')}
    label="The economic case"
    dark
    heading="Long-Term Impact for the Region"
    intro="Independent 25-year analysis projects that FSIC will generate, with full implementation (the Master Plan's FSIC 2.0 scenario):"
  >
    <!-- The range bars are the site's one automatic animation: they draw once when the list scrolls into
         view (global.css "Range bars draw in"; RangeBarsDraw). -->
    <ul class="range-bars border-t border-rule-on-dark" role="list" data-range-bars>
      {impact.map((row, i) => (
        <li class="grid gap-y-3 py-6 border-b border-rule-on-dark lg:grid-cols-12 lg:gap-x-8 lg:items-baseline" style={`--row:${i}`}>
          <p class="lg:col-span-4 mb-0 text-3xl md:text-4xl font-bold text-white font-display leading-tight tabular-nums">{row.display}</p>
          <p class="lg:col-span-4 mb-0 font-sans text-white/75">{row.label}</p>
          <RangeBar low={row.low} high={row.high} class="lg:col-span-4 lg:self-center" />
        </li>
      ))}
    </ul>
    <div class="grid gap-y-3 lg:grid-cols-12 lg:gap-x-8 mt-4">
      <p class="lg:col-span-8 mb-0 text-caption text-white/60">A job-year is one job held for one year.</p>
      <RangeLegend dark class="lg:col-span-4 mb-0" />
    </div>

    <Grid class="mt-16">
      <p slot="label" class="mb-0 text-statement text-white">This is not a short-term program. It is a durable economic backbone.</p>
      <div class="max-w-3xl">
        <p class="text-white/90 mb-8">
          In addition, FSIC positions the region to attract <strong class="text-white">{FIGURES.externalFunding.words}</strong> in external federal, state, private, and philanthropic investment tied to research, innovation, and workforce development.
        </p>
        <!-- From Strategic Value to Volusia County (folded in here, docs/10-homepage-plan.md A4) -->
        <dl class="mb-8">
          <Row label="Alignment with Major Funding Channels" dark>
            <p class="mb-0 text-white/90">
              FSIC is positioned to <a href={url('/partnership-funding#funding')} class="link-on-dark">pursue and coordinate funding</a> through NSF Engines, regional innovation grants, state workforce programs, and Space Florida tools — bringing outside dollars into the region.
            </p>
          </Row>
        </dl>
        <Button href="/economic-impact" variant="secondary-light">Explore the Full Economic Analysis</Button>
        <p class="text-caption text-white/60 mt-10 mb-0">
          {SOURCE}
        </p>
      </div>
    </Grid>
  </Section>

  <!-- 03 THE FOUR-ENGINE MODEL: four numbered columns on the grid (3 cols each) -->
  <Section
    {...at('model')}
    label="The four-engine model"
    heading="One Coordinated Platform. Four Integrated Engines."
    intro="FSIC operates through a structured, phased model designed for early activation and long-term scale."
  >
    <ol class="grid gap-y-10 md:grid-cols-2 lg:grid-cols-12 lg:gap-x-8">
      {engines.map((engine, i) => (
        <li class="lg:col-span-3 border-t border-navy/25 pt-5">
          <p class="text-caption text-gray tabular-nums flex items-center gap-2 mb-3">
            <Dot tone={engine.tone} size="md" />
            {pad2(i + 1)}
          </p>
          <h3 class="mb-2">{engine.name}</h3>
          <p class:list={['font-sans font-medium mb-3', engine.tone === 'lagoon' ? 'text-lagoon' : 'text-gray-dark']}>{engine.shift}</p>
          <p class="mb-0">{engine.homeSummary}</p>
        </li>
      ))}
    </ol>

    <Grid class="mt-14 pt-6 border-t border-rule">
      <p slot="label" class="mb-0 text-statement text-navy">Each engine reinforces the others. Together, they create a coordinated regional ecosystem.</p>
      <div>
        <!-- From Strategic Value to Volusia County (folded in here, docs/10-homepage-plan.md A4) -->
        <dl class="mb-8">
          <Row label="Talent Attraction & Retention" rule="bottom">
            <p class="mb-0">
              Integrated programming strengthens <a href={url('/programs-facilities#audiences')} class="link">local career pathways</a> and helps retain young professionals who want opportunity close to home.
            </p>
          </Row>
        </dl>
        <Button href="/model" variant="secondary">Learn More About the FSIC Model</Button>
      </div>
    </Grid>
  </Section>

  <!-- 04 PHASED DEPLOYMENT -->
  <Section {...at('deployment')} label="Phased deployment" spacing="stacked" heading="Start Small. Deliver Early Wins. Scale with Readiness.">
    <Grid class="gap-y-10">
      <p slot="label" class="mb-0 text-statement text-navy">Growth is structured. Not speculative.</p>
      <p class="max-w-3xl">
        FSIC launches with the Talent Engine — requiring minimal physical footprint while delivering immediate workforce and employer-support outcomes.
      </p>
      <p class="max-w-3xl mb-10">
        As partnerships deepen and demand grows, the Innovation, Market, and Civic Engines scale in alignment with regional development timelines.
      </p>

      <!-- The five phases (src/data/phases.ts) as rows: phase and timeframe (2 of 8 cols) | name (6 of 8).
           Phase 1 names the Talent Engine programs it launches (Master Plan p. 13). The dot is
           the phase's engine color (orange industry, lagoon Civic, navy integration). -->
      <ol class="border-t border-rule" aria-label="The five phases">
        {phases.map((phase, i) => (
          <li class="grid gap-y-1 py-4 border-b border-rule last:border-b-0 md:grid-cols-8 md:gap-x-8 md:items-baseline">
            <p class="md:col-span-2 mb-0 text-label text-gray-dark tabular-nums flex items-start gap-2">
              <Dot tone={phase.tone} class="mt-1.5" />
              <span>Phase {i + 1} · {phase.timeframe}{phase.current && <span class="block text-navy">Under way</span>}</span>
            </p>
            <div class="md:col-span-6">
              <h3 class="text-xl mb-0">
                <a href={url(`/deployment#${phase.id}`)} class="underline-reveal underline-offset-4 decoration-2">{phase.name}</a>
              </h3>
              {i === 0 && (
                <p class="mt-2 mb-0 text-gray-dark">
                  Micro-credential academies, dual-enrollment STEM pathways, teacher upskilling, and the Regional Talent Marketplace.
                </p>
              )}
            </div>
          </li>
        ))}
      </ol>

      <dl class="mb-8">
        <Row label="This phased approach:">
          <List columns items={['Reduces risk', 'Aligns with funding cycles', 'Ensures operational discipline', 'Builds momentum before expansion']} />
        </Row>
      </dl>
      <Button href="/deployment" variant="secondary">View the Deployment Timeline</Button>
    </Grid>
  </Section>

  <!-- 05 UNDERWAY: proof that FSIC is active, then how it is run. The three newest press releases (date,
       then headline, as published) in the content column; no release graphics here (DESIGN.md "Imagery").
       Governance & Transparency follows as a closing row (its own section until docs/10-homepage-plan.md A3). -->
  <Section {...at('news')} label="Latest news and governance" spacing="stacked" heading="FSIC Is Underway">
    <Grid labelOffset>
      <p slot="label" class="mb-0 text-statement text-navy">Launched May 25, 2026. Building its leadership and partnerships now.</p>
      <div class="max-w-3xl">
        <ol class="divide-y divide-rule border-y border-rule mb-10">
          {latest.map((r) => (
            <li class="py-5">
              <p class="mb-1 text-label text-gray-dark">
                <time datetime={isoDate(r.data.date)}>{formatDate(r.data.date)}</time>
              </p>
              <h3 class="text-xl md:text-2xl mb-0">
                <a href={releaseHref(r)} class="underline-reveal underline-offset-4 decoration-2">{r.data.title}</a>
              </h3>
            </li>
          ))}
        </ol>
        <Button href="/news" variant="secondary">All News & Media</Button>
        <p class="mt-6 mb-0 font-sans">
          Follow FSIC on {SOCIAL_LINKS.map((s, i) => (
            <>{i > 0 && (i === SOCIAL_LINKS.length - 1 ? ', and ' : ', ')}<a href={s.href} class="link" rel="noopener">{s.label}</a></>
          ))}.
        </p>
      </div>
    </Grid>

    <Grid class="mt-14 pt-6 border-t border-rule gap-y-10">
      <div slot="label">
        <h3 class="mb-3">Governance & Transparency</h3>
        <p class="mb-0 text-navy">FSIC operates under a partner-first, coalition-driven governance structure.</p>
      </div>
      <div class="max-w-3xl">
        <dl class="mb-8">
          <Row label="It is designed to:" rule="bottom">
            <List
              spacious
              items={[
                'Strengthen — not compete with — existing institutions',
                'Maintain transparent oversight',
                'Deliver shared value across education, industry, and community stakeholders',
                'Scale only when readiness and demand are clear',
              ]}
            />
          </Row>
          {people.map((g) => (
            <Row label={g.group} rule="bottom" class="pt-5">
              <List
                html
                items={g.members.map((m) => `<a href="${url(`/news/${m.slug}`)}" class="link">${m.name}</a>${m.role ? `, ${m.role}` : ''}`)}
              />
            </Row>
          ))}
        </dl>
        <p class="text-statement text-navy mb-8">Neutral convener. Clear structure. Long-term accountability.</p>
        <Button href="/governance" variant="secondary">Review Governance & Structure</Button>
      </div>
    </Grid>
  </Section>

  <!-- 06 LONG-RANGE VISION: the campus rendering, labeled as a concept -->
  <Section {...at('vision')} label="Long-range vision" dark heading="A Landmark Campus for Southeast Volusia">
    <ConceptRendering slot="media" />
    <Grid class="gap-y-10">
      <p slot="label" class="mb-0 text-xl text-white/90 leading-snug">
        As the model matures, FSIC evolves into a permanent anchor institution for Southeast Volusia.
      </p>
      <dl class="mb-8">
        <Row label="The long-term vision includes:" rule="bottom" dark>
          <List
            spacious class="text-white/90"
            items={[
              'A multi-university consortium with shared research facilities',
              'Applied labs and innovation studios',
              'A multipurpose auditorium and performing arts center',
              'Public gathering spaces integrating arts, science, and community programming',
            ]}
          />
        </Row>
      </dl>
      <p class="mb-0 text-statement">
        The future is built in phases.<br />The commitment begins now.
      </p>
      <Button href="/long-term-vision" variant="secondary-light" class="mt-8">View the Long-Term Vision</Button>
    </Grid>
  </Section>

  <!-- FINAL CTA: the page's close, so no running head. Residents' common questions sit in the label column, each linking to its FAQ answer (who can take part is Where You Fit, under the hero). -->
  <Section spacing="large" heading="Partner. Collaborate. Participate.">
    <Grid class="gap-y-10">
      <div slot="label">
        <p class="text-label text-navy mb-3">Common questions</p>
        <List items={commonQuestions.map((f) => `<a href="${url(`/faq#${f.id}`)}" class="link">${f.q}</a>`)} html />
      </div>
      <div class="max-w-3xl">
        <p>
          The Florida Space Innovation Center represents a coordinated investment in the region's future.
        </p>
        <p class="mb-10">
          Whether you are an employer, university leader, policymaker, workforce partner, or community member, there is a role to play in shaping Southeast Volusia's place in the global space economy.
        </p>
        <div class="flex flex-wrap gap-4">
          <Button href="/partnership-funding" variant="primary">Become a Partner</Button>
          <Button href="/contact" variant="secondary">Contact FSIC</Button>
        </div>
      </div>
    </Grid>
  </Section>

  <RangeBarsDraw />
  </div>

</BaseLayout>

