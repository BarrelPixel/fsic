---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CoastlineMap from '../components/CoastlineMap.astro';
import Section from '../components/Section.astro';
import Grid from '../components/Grid.astro';
import Row from '../components/Row.astro';
import DashList from '../components/DashList.astro';

const base = import.meta.env.BASE_URL;

// 25-year projections, Master Plan pp. 7–8. Always show the full range (see docs/08 §3.2).
const impact = [
  { label: 'Total economic output', low: 10.2, high: 12.4, display: '$10.2–$12.4 billion' },
  { label: 'Job-years across aerospace, engineering, advanced manufacturing, and technology', low: 74500, high: 79500, display: '74,500–79,500' },
  { label: 'New wages for Florida workers', low: 1.35, high: 1.55, display: '$1.35–$1.55 billion' },
  { label: 'Fiscal revenue for local and state governments', low: 690, high: 910, display: '$690–$910 million' },
];

const engines = [
  {
    name: 'Talent Engine',
    shift: 'Transforming individuals into skilled talent',
    body: 'Drives employer-aligned training, micro-credential academies, dual-enrollment pathways, and industry-embedded learning.',
    tone: 'orange',
  },
  {
    name: 'Innovation Engine',
    shift: 'Transforming knowledge into innovation',
    body: 'Powers challenge labs, applied research partnerships, prototyping studios, and university collaboration.',
    tone: 'orange',
  },
  {
    name: 'Market Engine',
    shift: 'Transforming opportunity into market success',
    body: 'Accelerates supplier readiness, startup development, SBIR/STTR navigation, and venture pathways.',
    tone: 'orange',
  },
  {
    name: 'Civic Engine',
    shift: 'Transforming innovation into shared identity',
    body: 'Engages the broader community through STEM programming, exhibitions, arts-and-space initiatives, and public events.',
    tone: 'lagoon',
  },
];

const value = [
  {
    title: 'Year-Round Activation',
    body: 'Daily activity from students, educators, employers, and events supports small businesses and drives regional economic circulation.',
  },
  {
    title: 'Talent Attraction & Retention',
    body: 'Integrated programming strengthens local career pathways and helps retain young professionals who want opportunity close to home.',
  },
  {
    title: 'Employer Attraction & Higher-Wage Growth',
    body: "By strengthening workforce alignment and innovation capacity, FSIC enhances Volusia County's competitiveness for aerospace and technology employers.",
  },
  {
    title: 'Alignment with Major Funding Channels',
    body: 'FSIC is positioned to pursue and coordinate funding through NSF Engines, regional innovation grants, state workforce programs, and Space Florida tools — bringing outside dollars into the region.',
  },
];

const audiences = ['Employers', 'University leaders', 'Policymakers', 'Workforce partners', 'Community members'];
---
<BaseLayout title="Florida Space Innovation Center">

  <!--
    GRID (DESIGN.md "Grid"): one 12-column grid. Label column = cols 1–4, content column = cols 5–12.
    Sections use <Section> (running head, heavy rule, headline) and <Grid> (label | content).
    Copy is verbatim from src/content/copy/home.md.
  -->

  <!-- HERO: the coastline and launch arc are the signature element (DESIGN.md) -->
  <section class="bg-night text-white overflow-hidden">
    <div class="container pt-14 pb-20 md:pt-20 md:pb-28 grid gap-14 lg:grid-cols-12 lg:gap-x-8 lg:items-start">
      <div class="lg:col-span-6 max-w-2xl">
        <h1 class="text-white mb-8">A New Commitment to the Space Coast</h1>
        <div class="text-lg text-white/80 leading-relaxed space-y-5 mb-10">
          <p>
            On May 25, 1961, the United States committed to landing a man on the Moon — not because it was easy, but because it demanded coordination, capability, and national resolve.
          </p>
          <p>
            Sixty-five years later, Southeast Volusia launches its own coordinated commitment: to strengthen our regional workforce, accelerate innovation, support industry growth, and ensure that the Space Coast's expansion directly benefits the people who live and work here.
          </p>
          <p class="text-white font-semibold">
            The Florida Space Innovation Center is that commitment in action.
          </p>
        </div>
        <div class="flex flex-wrap gap-4">
          <Button href="/model" variant="primary">Explore the Vision</Button>
          <Button href="/economic-impact" variant="secondary-light">View Economic Impact</Button>
        </div>
      </div>
      <div class="lg:col-span-6">
        <CoastlineMap />
      </div>
    </div>
  </section>

  <!-- 01 THE STRATEGIC MOMENT -->
  <Section id="strategic-moment" index={1} total={7} label="The strategic moment">
    <Fragment slot="heading">
      The Question Is Not Whether the Space Coast Will Grow.
      <span class="block mt-3 font-medium text-gray-dark">It Is Whether Southeast Volusia Will Participate in That Growth.</span>
    </Fragment>
    <Grid>
      <p slot="label" class="mb-0 font-display text-2xl font-semibold leading-snug text-navy">Without coordination, growth concentrates elsewhere.</p>
      <div class="max-w-3xl text-lg">
        <p>
          Florida's space economy is expanding rapidly — driven by commercial launch activity, advanced manufacturing, aerospace engineering, and emerging technologies.
        </p>
        <p>
          The Florida Space Innovation Center (FSIC) ensures that Southeast Volusia is not a spectator to that growth, but an active participant — building the talent, infrastructure, and partnerships required to compete in a global innovation economy.
        </p>
        <p class="mt-8 pt-6 border-t border-navy/15 text-navy font-medium">
          FSIC is designed to align education, industry, and community in one coordinated regional platform.
        </p>
      </div>
    </Grid>
  </Section>

  <!-- 02 THE ECONOMIC CASE: a table on the page grid. Figure (cols 1–4) | what it measures (5–8) | range bar (9–12) -->
  <Section
    id="economic-impact"
    index={2}
    total={7}
    label="The economic case"
    dark
    heading="Transformational, Long-Term Regional Impact"
    intro="Independent 25-year analysis projects that FSIC will generate:"
  >
    <ul class="border-t border-white/25" role="list">
      {impact.map((row) => {
        const lowPct = Math.round((row.low / row.high) * 100);
        return (
          <li class="grid gap-y-3 py-6 border-b border-white/25 lg:grid-cols-12 lg:gap-x-8 lg:items-baseline">
            <p class="lg:col-span-4 mb-0 text-3xl md:text-4xl font-bold text-white font-display leading-tight tabular-nums">{row.display}</p>
            <p class="lg:col-span-4 mb-0 font-sans text-white/75">{row.label}</p>
            <div class="lg:col-span-4 lg:self-center h-2.5 bg-white/10 flex" aria-hidden="true">
              <div class="h-full bg-orange" style={`width:${lowPct}%`}></div>
              <div class="h-full bg-orange/40" style={`width:${100 - lowPct}%`}></div>
            </div>
          </li>
        );
      })}
    </ul>
    <div class="grid lg:grid-cols-12 lg:gap-x-8 mt-4">
      <p class="lg:col-start-9 lg:col-span-4 font-sans text-sm text-white/60 flex items-center gap-3 mb-0">
        <span class="inline-flex gap-1" aria-hidden="true">
          <span class="w-4 h-2 bg-orange"></span><span class="w-4 h-2 bg-orange/40"></span>
        </span>
        Solid bar: low estimate. Lighter extension: range to the high estimate.
      </p>
    </div>

    <Grid class="mt-16">
      <p slot="label" class="mb-0 font-display text-2xl font-semibold leading-snug text-white">This is not a short-term program. It is a durable economic backbone.</p>
      <div class="max-w-3xl">
        <p class="text-lg text-white/85 mb-8">
          In addition, FSIC positions the region to attract <strong class="text-white">$800 Million to $1.56 Billion</strong> in external federal, state, private, and philanthropic investment tied to research, innovation, and workforce development.
        </p>
        <Button href="/economic-impact" variant="secondary-light">Explore the Full Economic Analysis</Button>
        <p class="font-sans text-sm text-white/60 mt-10 mb-0">
          Source: FSIC Master Plan 2026–2031. These are estimates based upon assumptions that may or may not be accurate over time.
        </p>
      </div>
    </Grid>
  </Section>

  <!-- 03 THE FOUR-ENGINE MODEL: four numbered columns on the grid (3 cols each) -->
  <Section
    id="model"
    index={3}
    total={7}
    label="The four-engine model"
    heading="One Coordinated Platform. Four Integrated Engines."
    intro="FSIC operates through a structured, phased model designed for early activation and long-term scale."
  >
    <ol class="grid gap-y-10 md:grid-cols-2 lg:grid-cols-12 lg:gap-x-8">
      {engines.map((engine, i) => (
        <li class="lg:col-span-3 border-t border-navy/25 pt-5">
          <p class="font-sans text-sm text-gray tabular-nums flex items-center gap-2 mb-3">
            <span class:list={['w-2.5 h-2.5 rounded-full', engine.tone === 'lagoon' ? 'bg-lagoon' : 'bg-orange']} aria-hidden="true"></span>
            {String(i + 1).padStart(2, '0')}
          </p>
          <h3 class="mb-2">{engine.name}</h3>
          <p class:list={['font-sans font-medium mb-3', engine.tone === 'lagoon' ? 'text-lagoon' : 'text-gray-dark']}>{engine.shift}</p>
          <p class="mb-0">{engine.body}</p>
        </li>
      ))}
    </ol>

    <Grid class="mt-14 pt-6 border-t border-navy/15">
      <p slot="label" class="mb-0 font-display text-2xl font-semibold leading-snug text-navy">Each engine reinforces the others. Together, they create a coordinated regional ecosystem.</p>
      <Button href="/model" variant="secondary">Learn More About the FSIC Model</Button>
    </Grid>
  </Section>

  <!-- 04 PHASED DEPLOYMENT -->
  <Section id="deployment" index={4} total={7} label="Phased deployment" spacing="stacked" heading="Start Small. Deliver Early Wins. Scale with Readiness.">
    <Grid class="gap-y-10">
      <p slot="label" class="mb-0 font-display text-2xl font-semibold leading-snug text-navy">Growth is structured. Not speculative.</p>
      <p class="text-lg max-w-3xl">
        FSIC launches with the Talent Engine — requiring minimal physical footprint while delivering immediate workforce and employer-support outcomes.
      </p>
      <p class="text-lg max-w-3xl mb-10">
        As partnerships deepen and demand grows, the Innovation, Market, and Civic Engines scale in alignment with regional development timelines.
      </p>

      <ol class="grid gap-y-6 md:grid-cols-2 md:gap-x-8 mb-10">
        <li class="border-t-2 border-orange pt-4">
          <h3 class="mb-1">First: the Talent Engine</h3>
          <p class="mb-0">Minimal physical footprint. Immediate workforce and employer-support outcomes.</p>
        </li>
        <li class="border-t-2 border-navy/25 pt-4">
          <h3 class="mb-1">Then: Innovation, Market, and Civic</h3>
          <p class="mb-0">Each scales as partnerships deepen and demand grows.</p>
        </li>
      </ol>

      <dl class="mb-8">
        <Row label="This phased approach:">
          <DashList columns items={['Reduces risk', 'Aligns with funding cycles', 'Ensures operational discipline', 'Builds momentum before expansion']} />
        </Row>
      </dl>
      <Button href="/deployment" variant="secondary">View the Deployment Timeline</Button>
    </Grid>
  </Section>

  <!-- 05 STRATEGIC VALUE: community value, so lagoon rules. Peers as a 2×2 grid in the content column. -->
  <Section id="value" index={5} total={7} dot="lagoon" spacing="stacked" heading="Strategic Value to Volusia County">
    <Grid class="gap-y-10" labelOffset>
      <p slot="label" class="mb-0 font-display text-2xl font-semibold leading-snug text-navy">This is a coordinated regional investment — not a standalone facility.</p>
      <div class="grid gap-x-8 gap-y-10 md:grid-cols-2">
        {value.map((item) => (
          <div class="border-t-2 border-lagoon pt-5">
            <h3 class="mb-3">{item.title}</h3>
            <p class="mb-0">{item.body}</p>
          </div>
        ))}
      </div>
    </Grid>
  </Section>

  <!-- 06 LONG-RANGE VISION: the campus rendering, labeled as a concept -->
  <Section id="vision" index={6} total={7} label="Long-range vision" dark heading="A Landmark Campus for Southeast Volusia">
    <figure slot="media" class="relative">
      <img
        src={`${base}/images/fsic-concept.jpg`}
        alt="Concept rendering of a future campus: research buildings, a tower, and a glass dome set among wetlands, palms, and a boardwalk."
        width="1536"
        height="1024"
        loading="lazy"
        decoding="async"
        class="w-full h-[50vh] min-h-[320px] max-h-[640px] object-cover"
      />
      <figcaption class="font-sans container text-sm text-white/60 pt-3">Concept rendering. Design and location to be determined.</figcaption>
    </figure>
    <Grid class="gap-y-10">
      <p slot="label" class="mb-0 text-xl text-white/85 leading-snug">
        As the model matures, FSIC evolves into a permanent anchor institution for Southeast Volusia.
      </p>
      <dl class="mb-8">
        <Row label="The long-term vision includes:" rule="bottom" dark>
          <DashList
            marker="lagoon-light"
            spacious class="text-lg text-white/85"
            items={[
              'A multi-university consortium with shared research facilities',
              'Applied labs and innovation studios',
              'A multipurpose auditorium and performing arts center',
              'Public gathering spaces integrating arts, science, and community programming',
            ]}
          />
        </Row>
      </dl>
      <p class="mb-0 font-display text-2xl font-semibold leading-snug">
        The future is built in phases.<br />The commitment begins now.
      </p>
    </Grid>
  </Section>

  <!-- 07 GOVERNANCE & TRANSPARENCY -->
  <Section id="governance" index={7} total={7} heading="Governance & Transparency">
    <Grid class="gap-y-10">
      <p slot="label" class="mb-0 text-xl text-navy leading-snug">
        FSIC operates under a partner-first, coalition-driven governance structure.
      </p>
      <dl class="mb-8">
        <Row label="It is designed to:" rule="bottom">
          <DashList
            spacious class="text-lg"
            items={[
              'Strengthen — not compete with — existing institutions',
              'Maintain transparent oversight',
              'Deliver shared value across education, industry, and community stakeholders',
              'Scale only when readiness and demand are clear',
            ]}
          />
        </Row>
      </dl>
      <p class="font-display text-2xl text-navy font-semibold leading-snug mb-8">Neutral convener. Clear structure. Long-term accountability.</p>
      <Button href="/governance" variant="secondary">Review Governance & Structure</Button>
    </Grid>
  </Section>

  <!-- FINAL CTA: the page's close, so no running head. Who can take part sits in the label column as a plain list. -->
  <Section dark spacing="large" heading="Partner. Collaborate. Participate.">
    <Grid class="gap-y-10">
      <ul slot="label" class="font-sans flex flex-col divide-y divide-white/25 border-b border-white/25" aria-label="Who can take part">
        {audiences.map((a) => (
          <li class="py-2.5 first:pt-0 text-lagoon-light">{a}</li>
        ))}
      </ul>
      <div class="max-w-3xl">
        <p class="text-lg text-white/80">
          The Florida Space Innovation Center represents a coordinated investment in the region's future.
        </p>
        <p class="text-lg text-white/80 mb-10">
          Whether you are an employer, university leader, policymaker, workforce partner, or community member, there is a role to play in shaping Southeast Volusia's place in the global space economy.
        </p>
        <div class="flex flex-wrap gap-4">
          <Button href="/partnership-funding" variant="primary">Become a Partner</Button>
          <Button href="/contact" variant="secondary-light">Contact FSIC</Button>
        </div>
      </div>
    </Grid>
  </Section>

</BaseLayout>
