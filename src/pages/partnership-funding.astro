---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Grid from '../components/Grid.astro';
import Row from '../components/Row.astro';
import List from '../components/List.astro';
import { mailto } from '../lib/site';
import HeroIndex from '../components/HeroIndex.astro';
import { pad2 } from '../lib/format';
import Closing from '../components/Closing.astro';
import { FIGURES } from '../data/economics';
import { benefits, partners, streams } from '../data/partnership';
import Disclosure from '../components/Disclosure.astro';
import SectionBar from '../components/SectionBar.astro';

// Copy: src/content/copy/partnership-funding.md (Draft). Partner table: Master Plan pp. 22–24;
// funding streams: pp. 25–26; benefits: May 25, 2026 launch release; get involved: FAQ.
// Open review items: no years given for employer funding; "Build Back Better"; no named partners.


const YEARS = [1, 2, 3, 4, 5];
const yearsLabel = (s: { start: number | null; end: number | null }) =>
  s.start === null ? 'Years not stated' : s.start === s.end ? `Year ${s.start}` : `Years ${s.start}–${s.end}`;
---
<BaseLayout title="Partnership & Funding" description="How employers, schools, universities, governments, agencies and community organizations partner with FSIC, and how FSIC is funded.">

  <!-- Interior page template (DESIGN.md): PageHero with an index of partner types, narrative sections, closing -->
  <PageHero title="Partner. Collaborate. Participate.">
    <p class="text-lead text-white/90 mb-6">
      The Florida Space Innovation Center represents a coordinated investment in the region's future.
    </p>
    <p class="text-white/75 mb-10 max-w-3xl">
      Whether you are an employer, university leader, policymaker, workforce partner, or community member, there is a role to play in shaping Southeast Volusia's place in the global space economy.
    </p>

    <!-- Partner index: each type links to its row in section 02 -->
    <HeroIndex label="Partner types" items={partners} columns />
  </PageHero>

  <!-- The wrapper bounds the sticky section bar to the numbered sections; it scrolls away before the closing -->
  <div>
    <SectionBar
      ariaLabel="Sections on this page"
      numbered
      items={[
        { id: 'why-partner', label: 'Why partner' },
        { id: 'partners', label: 'Partners' },
        { id: 'funding', label: 'Funding' },
        { id: 'get-involved', label: 'Get involved' },
      ]}
    />

  <!-- 01 · WHY PARTNER: three peers on the grid (4 cols each) -->
  <Section id="why-partner" class="scroll-mt-20" index={1} total={4} label="Why partner" heading="Three Core Benefits for Florida Stakeholders">
    <ol class="grid gap-y-10 lg:grid-cols-12 lg:gap-x-8">
      {benefits.map((b, i) => (
        <li class="lg:col-span-4 border-t-2 border-navy pt-5">
          <p class="text-caption text-gray tabular-nums mb-3">{pad2(i + 1)}</p>
          <h3 class="mb-3">{b.title}</h3>
          <p class="mb-0">{b.body}</p>
        </li>
      ))}
    </ol>

    <Grid class="mt-14 pt-6 border-t border-rule">
      <p slot="label" class="mb-0 text-label text-navy md:pt-label-offset">A proven foundation</p>
      <p class="max-w-3xl mb-0">
        FSIC is built on approaches that have already delivered measurable results in other regions. It draws on the coordinated innovation model that propelled the quantum ecosystem in the Washington, D.C. area and the structured talent and industry strategy that reshaped Osceola County's semiconductor sector. These proven frameworks demonstrate how communities can organize, align partners, and attract major outside investment — and FSIC adapts these lessons to Florida's rapidly expanding space economy.
      </p>
    </Grid>
  </Section>

  <!-- 02 · PARTNERS: one row per partner type; roles and benefits open in place -->
  <Section
    id="partners" class="scroll-mt-20"
    index={2}
    total={4}
    spacing="stacked"
    heading="Partnership Strategy and Regional Alignment"
    intro="The Florida Space Innovation Center is designed as a regional backbone organization that aligns employers, educators, governments, and community partners around a shared economic future."
  >
    <!-- Each partner type: number and name (cols 1–4) | overview, then its roles and benefits, each opening in place (cols 5–12) -->
    <div class="border-t-2 border-navy">
      {partners.map((p, i) => (
        <div id={p.id} class="scroll-mt-16 grid gap-y-3 py-6 border-b border-rule lg:grid-cols-12 lg:gap-x-8">
          <h3 class="lg:col-span-4 mb-0 text-xl flex items-baseline gap-2">
            <span class="w-6 shrink-0 text-caption text-gray tabular-nums font-normal">{pad2(i + 1)}</span>
            {p.name}
          </h3>
          <div class="lg:col-span-8 max-w-3xl">
            <p class="mb-4 text-gray-dark">{p.overview}</p>
            <div>
              <Disclosure class="border-t border-rule" summaryClass="items-center gap-4 py-3">
                <span slot="summary" class="text-label text-navy">Partnership roles<span class="font-medium text-gray"> · {p.roles.length}</span></span>
                <List items={p.roles} class="pb-4 text-gray-dark" />
              </Disclosure>
              <Disclosure class="border-t border-rule" summaryClass="items-center gap-4 py-3">
                <span slot="summary" class="text-label text-navy">Strategic benefits<span class="font-medium text-gray"> · {p.benefits.length}</span></span>
                <List items={p.benefits} class="pb-4 text-navy" />
              </Disclosure>
            </div>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- 03 · FUNDING: the blend, then the streams on a Years 1–5 axis -->
  <Section id="funding" class="scroll-mt-20" index={3} total={4} label="Funding" heading="How Is FSIC Funded?">
    <Grid>
      <div slot="label">
        <p class="text-xl text-navy leading-snug mb-4">FSIC uses a proven public-private funding model that blends:</p>
        <List
          items={['Philanthropic and private investment', 'State and federal workforce grants', 'Space Florida and economic development programs', 'Earned revenue from training, partnerships, events and other activities.']}
        />
      </div>
      <p class="max-w-3xl mb-0 lg:pt-1">
        The Florida Space Innovation Center is designed with a diversified, sustainable funding model that aligns with national best practices for nonprofit innovation hubs. The strategy balances philanthropy, public funding, employer partnerships, earned revenue, and federal grants. This approach reduces risk, strengthens long-term sustainability, and positions FSIC to scale responsibly as regional demand grows.
      </p>
    </Grid>

    <!-- Streams: name + years (cols 1–4) | purpose and sources (5–8) | Years 1–5 track (9–12) -->
    <div class="mt-14">
      <div class="hidden lg:grid lg:grid-cols-12 lg:gap-x-8 border-b-2 border-navy pb-3" aria-hidden="true">
        <p class="lg:col-span-4 mb-0 text-label text-navy">Funding stream</p>
        <p class="lg:col-span-4 mb-0 text-label text-navy">Purpose and sources</p>
        <p class="lg:col-span-4 mb-0 grid grid-cols-5 text-caption text-gray tabular-nums">
          {YEARS.map((y) => <span>Year {y}</span>)}
        </p>
      </div>
      {streams.map((s) => (
        <div class="grid gap-y-3 py-6 border-b border-rule lg:grid-cols-12 lg:gap-x-8">
          <div class="lg:col-span-4">
            <h3 class="text-xl mb-1">{s.name}</h3>
            <p class="mb-0 text-caption text-gray-dark">{yearsLabel(s)}</p>
          </div>
          <div class="lg:col-span-4">
            <p class="text-base text-gray-dark mb-2">{s.purpose}</p>
            <p class="mb-0 text-caption text-gray-dark"><span class="font-semibold text-navy">Sources:</span> {s.sources.join(' · ')}</p>
          </div>
          <div class="lg:col-span-4 lg:pt-2" aria-hidden="true">
            <span class="grid grid-cols-5 h-3 bg-navy/[0.07]">
              {s.start !== null && s.end !== null && (
                <span class="h-full bg-navy-light" style={`grid-column: ${s.start} / ${s.end + 1}`}></span>
              )}
            </span>
          </div>
        </div>
      ))}
      <p class="mt-3 mb-0 text-caption text-gray-dark">Timeframes: FSIC Master Plan 2026–2031. The plan gives no timeframe for employer partnerships.</p>
    </div>

    <Grid class="mt-16">
      <p slot="label" class="mb-0 text-statement text-navy">
        By Year 3, FSIC is positioned to sustain 30–50% of its operating budget through earned revenue and employer partnerships, with grants and philanthropy supporting innovation and growth.
      </p>
      <div class="border-t-2 border-orange pt-5">
        <p class="mb-1 text-3xl md:text-4xl font-bold text-navy font-display leading-tight tabular-nums">{FIGURES.externalFunding.display}</p>
        <p class="mb-6 text-label text-navy">External funding potential · Extended FSIC (FSIC 2.0) scenario, over 25 years</p>
        <Button href="/economic-impact" variant="secondary">Explore the Full Economic Analysis</Button>
        <p class="text-caption text-gray-dark mt-6 mb-0">Source: FSIC Master Plan 2026–2031. These are estimates based upon assumptions that may or may not be accurate over time.</p>
      </div>
    </Grid>
  </Section>

  <!-- 04 · GET INVOLVED -->
  <Section id="get-involved" class="scroll-mt-20" index={4} total={4} label="Get involved" dark heading="How Can the Public Get Involved?">
    <Grid>
      <p slot="label" class="mb-0 text-xl text-white/90 leading-snug">
        FSIC is designed to be a community-powered movement, and there are many ways for residents, educators, businesses, and civic partners to participate from the very beginning.
      </p>
      <dl class="mb-8">
        <Row label="Residents can get involved through:" rule="bottom" dark>
          <List
            spacious
            class="text-white/90"
            items={[
              'Community STEM nights that bring families together around hands-on learning',
              'Public exhibitions and arts-and-space events that celebrate creativity and innovation',
              'Student programs and camps that spark curiosity and build early skills',
              'Volunteer and mentorship opportunities supporting learners, educators, and small businesses',
              'Employer councils and advisory groups that help shape training, innovation challenges, and regional strategy',
            ]}
          />
        </Row>
      </dl>
      <p class="text-white/75 max-w-3xl mb-0">
        In addition, FSIC is actively seeking leaders and volunteers with relevant experience across the Center's four core engines — Talent, Innovation, Market, and Civic. Individuals with backgrounds in STEM education, engineering, advanced manufacturing, entrepreneurship, arts and culture, workforce development, community engagement, or related fields are encouraged to step forward. These early contributors will help shape programs, guide partnerships, and build the foundation for FSIC's long-term impact.
      </p>
    </Grid>
  </Section>
  </div>

  <!-- CLOSING (Master Plan p. 22). "Contact FSIC" opens an email until the Contact page has a form. -->
  <Closing statement="The partnership strategy ensures that FSIC is not duplicating existing efforts but instead coordinating, amplifying, and accelerating them.">
    <Button href={mailto()}>Contact FSIC</Button>
    <Button href="/model" variant="secondary">Learn More About the FSIC Model</Button>
  </Closing>

</BaseLayout>
