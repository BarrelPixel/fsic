---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Grid from '../components/Grid.astro';
import Row from '../components/Row.astro';
import DashList from '../components/DashList.astro';

// Copy: src/content/copy/partnership-funding.md (Draft). Partner table: Master Plan pp. 22–24;
// funding streams: pp. 25–26; benefits: May 25, 2026 launch release; get involved: FAQ.
// Open review items: no years given for employer funding; "Build Back Better"; no named partners.

const benefits = [
  { title: 'Ecosystem Building & Convening Power', body: 'FSIC aligns schools, employers, civic organizations, and industry partners around shared priorities — reducing fragmentation and accelerating progress.' },
  { title: 'A Platform for Significant External Funding', body: 'By demonstrating readiness, coordination, and long-term strategy, FSIC positions Florida to compete for federal, philanthropic, and private-sector investment at a scale individual organizations cannot secure alone.' },
  { title: 'Closing Gaps in Workforce, Talent, and Innovation', body: 'FSIC strengthens the talent pipeline, supports innovators, and helps local companies grow — ensuring Florida has the skilled workforce and innovation capacity required for the next generation of space and technology industries.' },
];

const partners = [
  {
    id: 'employers',
    name: 'Employers & Industry',
    overview: "Employers are central to FSIC's mission. Their involvement ensures that programs remain aligned with real workforce needs, emerging technologies, and industry standards.",
    roles: ['Validate curriculum and micro-credentials', 'Provide challenge lab problems and innovation projects', 'Host internships, apprenticeships, and job shadowing', 'Participate in advisory councils'],
    benefits: ['Stronger talent pipelines', 'Reduced hiring friction', 'Increased employer retention and expansion', 'Enhanced competitiveness for federal funding'],
  },
  {
    id: 'k12',
    name: 'K–12 School Districts',
    overview: 'FSIC partners with school districts to expand STEM access, strengthen career pathways, and support teacher development.',
    roles: ['Co-design dual-enrollment and micro-credential pathways', 'Provide student access to challenge labs and innovation programs', 'Support teacher upskilling and professional development'],
    benefits: ['Improved student outcomes', 'Stronger career readiness', 'Expanded access to high-value opportunities', 'Enhanced district competitiveness'],
  },
  {
    id: 'higher-ed',
    name: 'State College & Universities',
    overview: 'Higher education institutions are essential partners in applied research, talent development, and innovation.',
    roles: ['Co-develop curriculum and degree pathways', 'Provide faculty expertise for challenge labs', 'Collaborate on applied research and dual-use technologies', 'Co-locate programs or research teams at FSIC', 'Pursue joint federal funding opportunities'],
    benefits: ['Expanded research impact', 'Stronger industry alignment', 'Increased competitiveness for grants', 'Enhanced student engagement and experiential learning'],
  },
  {
    id: 'local-government',
    name: 'Local Government',
    overview: "Cities and counties play a critical role in supporting FSIC's mission through policy alignment, economic development coordination, and community engagement.",
    roles: ['Support employer recruitment and retention', 'Align zoning and infrastructure with innovation district development', 'Collaborate on grant applications and federal funding', 'Promote community engagement and public events', 'Provide in-kind support and strategic alignment'],
    benefits: ['Stronger economic development outcomes', 'Increased competitiveness for state and federal investment', 'Enhanced community identity and cohesion', 'Support for long-term regional planning'],
  },
  {
    id: 'workforce-agencies',
    name: 'Economic Development & Workforce Agencies',
    overview: "Regional economic development organizations and workforce boards are essential partners in aligning FSIC's programs with broader regional strategies.",
    roles: ['Provide labor market data and analysis', 'Support employer engagement', 'Collaborate on workforce initiatives', 'Align regional strategies and funding opportunities', 'Support grant applications and reporting'],
    benefits: ['Stronger alignment across regional initiatives', 'Increased access to funding', 'Enhanced employer recruitment', 'Improved workforce outcomes'],
  },
  {
    id: 'agencies',
    name: 'Federal & State Agencies',
    overview: 'Federal and state agencies provide critical funding, technical expertise, and strategic alignment.',
    roles: ['Support applied research and innovation', 'Provide grant funding and technical assistance', 'Collaborate on dual-use technology development', 'Participate in challenge labs and innovation programs', 'Support workforce development initiatives'],
    benefits: ['Increased access to federal and state funding', 'Stronger regional competitiveness', 'Enhanced national visibility', 'Expanded research and innovation capacity'],
  },
  {
    id: 'community',
    name: 'Community & Civic Organizations',
    overview: "Community organizations, nonprofits, and civic groups ensure that FSIC's impact is broad-based and inclusive.",
    roles: ['Support community engagement and outreach', 'Collaborate on STEM events and exhibitions', 'Provide access to underserved populations', 'Strengthen regional storytelling and identity', 'Support volunteer and mentorship programs'],
    benefits: ['Stronger community trust', 'Expanded access to opportunities', 'Enhanced civic cohesion', 'Broader public support for innovation-driven growth'],
  },
];

// Funding streams, Master Plan pp. 25–26. start/end on the Years 1–5 axis; null = not stated in the source.
const streams = [
  { name: 'Startup Funding', start: 1, end: 2, purpose: 'Startup funding focuses on establishing core operations, launching the Talent Engine, and building early momentum.', sources: ['Philanthropic contributions', 'Family foundations', 'Corporate sponsorships', 'Local government support', 'In-kind contributions (space, equipment, staffing)'] },
  { name: 'Public Funding & Government Grants', start: 1, end: 5, purpose: "Public funding plays a critical role in scaling FSIC's programs and facilities.", sources: ['State workforce development grants', 'Florida Department of Education innovation funding', 'Space Florida partnerships', 'EDA Tech Hubs & Build Back Better programs', 'NSF Engines & STEM education grants'] },
  { name: 'Employer Partnerships & Corporate', start: null, end: null, purpose: "Employers benefit directly from FSIC's programs and therefore play a key role in funding operations and program delivery.", sources: ['Annual employer memberships', 'Sponsorship of labs, programs, and events', 'Equipment donations', 'Paid internships and apprenticeships', 'Co-funded research and innovation projects'] },
  { name: 'Earned Revenue Streams', start: 2, end: 5, purpose: "Earned revenue becomes a significant component of FSIC's financial model as programs mature and demand increases.", sources: ['Tuition for micro-credentials and adult training', 'Contract training for employers', 'Facility rentals for events and conferences', 'Innovation challenge sponsorships', 'Startup incubation fees'] },
  { name: 'Federal Innovation & Research Funding', start: 2, end: 5, purpose: "FSIC's Innovation and Market Engines position the organization to compete for major federal innovation funding.", sources: ['SBIR/STTR partnerships', 'Dual-use technology development grants', 'Applied research funding from DoD, NASA, NSF', 'EDA innovation and entrepreneurship grants'] },
  { name: 'Long-Term Sustainability Model', start: 3, end: 5, purpose: 'A balanced, diversified funding model ensures FSIC remains resilient, adaptable, and capable of long-term regional impact.', sources: ['Recurring employer memberships', 'Contract training', 'Startup and supplier development programs', 'Federal and state grants', 'Philanthropic support for innovation and expansion'] },
] as { name: string; start: number | null; end: number | null; purpose: string; sources: string[] }[];

const YEARS = [1, 2, 3, 4, 5];
const pad = (n: number) => String(n).padStart(2, '0');
const yearsLabel = (s: { start: number | null; end: number | null }) =>
  s.start === null ? 'Years not stated' : s.start === s.end ? `Year ${s.start}` : `Years ${s.start}–${s.end}`;
---
<BaseLayout title="Partnership & Funding" description="How employers, schools, universities, governments, agencies and community organizations partner with FSIC, and how FSIC is funded.">

  <!-- Interior page template (DESIGN.md): PageHero with an index of partner types, narrative sections, closing -->
  <PageHero title="Partner. Collaborate. Participate.">
    <p class="text-2xl text-white/90 leading-snug mb-6">
      The Florida Space Innovation Center represents a coordinated investment in the region's future.
    </p>
    <p class="text-lg text-white/75 mb-10 max-w-3xl">
      Whether you are an employer, university leader, policymaker, workforce partner, or community member, there is a role to play in shaping Southeast Volusia's place in the global space economy.
    </p>

    <!-- Partner index: each type links to its row in section 02 -->
    <nav aria-label="Partner types" class="font-sans">
      <ol class="border-t border-white/25 sm:columns-2 sm:gap-x-8">
        {partners.map((p, i) => (
          <li class="break-inside-avoid border-b border-white/25">
            <a href={`#${p.id}`} class="group flex items-baseline gap-3 py-3 rounded-sm">
              <span class="text-sm text-white/60 tabular-nums">{pad(i + 1)}</span>
              <span class="text-white group-hover:underline underline-offset-4">{p.name}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </PageHero>

  <!-- 01 · WHY PARTNER: three peers on the grid (4 cols each) -->
  <Section id="why-partner" index={1} total={4} label="Why partner" heading="Three Core Benefits for Florida Stakeholders">
    <ol class="grid gap-y-10 lg:grid-cols-12 lg:gap-x-8">
      {benefits.map((b, i) => (
        <li class="lg:col-span-4 border-t-2 border-navy pt-5">
          <p class="font-sans text-sm text-gray tabular-nums mb-3">{pad(i + 1)}</p>
          <h3 class="mb-3">{b.title}</h3>
          <p class="mb-0">{b.body}</p>
        </li>
      ))}
    </ol>

    <Grid class="mt-14 pt-6 border-t border-navy/15">
      <p slot="label" class="mb-0 font-sans text-sm font-semibold text-navy md:pt-[0.3rem]">A proven foundation</p>
      <p class="text-lg max-w-3xl mb-0">
        FSIC is built on approaches that have already delivered measurable results in other regions. It draws on the coordinated innovation model that propelled the quantum ecosystem in the Washington, D.C. area and the structured talent and industry strategy that reshaped Osceola County's semiconductor sector. These proven frameworks demonstrate how communities can organize, align partners, and attract major outside investment — and FSIC adapts these lessons to Florida's rapidly expanding space economy.
      </p>
    </Grid>
  </Section>

  <!-- 02 · PARTNERS: partner (cols 1–4) | partnership roles (5–8) | strategic benefits (9–12) -->
  <Section
    id="partners"
    index={2}
    total={4}
    spacing="stacked"
    heading="Partnership Strategy and Regional Alignment"
    intro="The Florida Space Innovation Center is designed as a regional backbone organization that aligns employers, educators, governments, and community partners around a shared economic future."
  >
    <div>
      <div class="hidden lg:grid lg:grid-cols-12 lg:gap-x-8 border-b-2 border-navy pb-3" aria-hidden="true">
        <p class="lg:col-span-4 mb-0 font-sans text-sm font-semibold text-navy">Partner</p>
        <p class="lg:col-span-4 mb-0 font-sans text-sm font-semibold text-navy">Partnership roles</p>
        <p class="lg:col-span-4 mb-0 font-sans text-sm font-semibold text-navy">Strategic benefits</p>
      </div>
      {partners.map((p, i) => (
        <div id={p.id} class="scroll-mt-4 grid gap-y-4 py-7 border-b border-navy/15 lg:grid-cols-12 lg:gap-x-8">
          <div class="lg:col-span-4">
            <p class="font-sans text-sm text-gray tabular-nums mb-2">{pad(i + 1)}</p>
            <h3 class="text-xl mb-2">{p.name}</h3>
            <p class="mb-0 text-base text-gray-dark">{p.overview}</p>
          </div>
          <div class="lg:col-span-4 lg:pt-7">
            <p class="lg:sr-only mb-2 font-sans text-sm font-semibold text-navy">Partnership roles</p>
            <DashList items={p.roles} marker="gray" class="text-gray-dark" />
          </div>
          <div class="lg:col-span-4 lg:pt-7">
            <p class="lg:sr-only mb-2 font-sans text-sm font-semibold text-navy">Strategic benefits</p>
            <DashList items={p.benefits} marker="navy" class="text-navy" />
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- 03 · FUNDING: the blend, then the streams on a Years 1–5 axis -->
  <Section id="funding" index={3} total={4} label="Funding" heading="How Is FSIC Funded?">
    <Grid>
      <div slot="label">
        <p class="text-xl text-navy leading-snug mb-4">FSIC uses a proven public-private funding model that blends:</p>
        <DashList
          items={['Philanthropic and private investment', 'State and federal workforce grants', 'Space Florida and economic development programs', 'Earned revenue from training, partnerships, events and other activities.']}
          marker="navy"
        />
      </div>
      <p class="text-lg max-w-3xl mb-0 lg:pt-1">
        The Florida Space Innovation Center is designed with a diversified, sustainable funding model that aligns with national best practices for nonprofit innovation hubs. The strategy balances philanthropy, public funding, employer partnerships, earned revenue, and federal grants. This approach reduces risk, strengthens long-term sustainability, and positions FSIC to scale responsibly as regional demand grows.
      </p>
    </Grid>

    <!-- Streams: name + years (cols 1–4) | purpose and sources (5–8) | Years 1–5 track (9–12) -->
    <div class="mt-14">
      <div class="hidden lg:grid lg:grid-cols-12 lg:gap-x-8 border-b-2 border-navy pb-3" aria-hidden="true">
        <p class="lg:col-span-4 mb-0 font-sans text-sm font-semibold text-navy">Funding stream</p>
        <p class="lg:col-span-4 mb-0 font-sans text-sm font-semibold text-navy">Purpose and sources</p>
        <p class="lg:col-span-4 mb-0 grid grid-cols-5 font-sans text-sm text-gray tabular-nums">
          {YEARS.map((y) => <span>Year {y}</span>)}
        </p>
      </div>
      {streams.map((s) => (
        <div class="grid gap-y-3 py-6 border-b border-navy/15 lg:grid-cols-12 lg:gap-x-8">
          <div class="lg:col-span-4">
            <h3 class="text-xl mb-1">{s.name}</h3>
            <p class="mb-0 font-sans text-sm text-gray-dark">{yearsLabel(s)}</p>
          </div>
          <div class="lg:col-span-4">
            <p class="text-base text-gray-dark mb-2">{s.purpose}</p>
            <p class="mb-0 font-sans text-sm text-gray-dark"><span class="font-semibold text-navy">Sources:</span> {s.sources.join(' · ')}</p>
          </div>
          <div class="lg:col-span-4 lg:pt-2" aria-hidden="true">
            <span class="grid grid-cols-5 h-3 bg-navy/[0.07]">
              {s.start !== null && s.end !== null && (
                <span class="h-full bg-navy-light" style={`grid-column: ${s.start} / ${s.end + 1}`}></span>
              )}
            </span>
          </div>
        </div>
      ))}
      <p class="mt-3 mb-0 font-sans text-sm text-gray-dark">Timeframes: FSIC Master Plan 2026–2031. The plan gives no timeframe for employer partnerships.</p>
    </div>

    <Grid class="mt-16">
      <p slot="label" class="mb-0 font-display text-2xl font-semibold text-navy leading-snug">
        By Year 3, FSIC is positioned to sustain 30–50% of its operating budget through earned revenue and employer partnerships, with grants and philanthropy supporting innovation and growth.
      </p>
      <div class="border-t-2 border-orange pt-5">
        <p class="mb-1 text-3xl md:text-4xl font-bold text-navy font-display leading-tight tabular-nums">$800 million–$1.56 billion</p>
        <p class="mb-6 font-sans text-sm font-semibold text-navy">External funding potential · Extended FSIC (FSIC 2.0) scenario, over 25 years</p>
        <Button href="/economic-impact" variant="secondary">Explore the Full Economic Analysis</Button>
        <p class="font-sans text-sm text-gray-dark mt-6 mb-0">Source: FSIC Master Plan 2026–2031. These are estimates based upon assumptions that may or may not be accurate over time.</p>
      </div>
    </Grid>
  </Section>

  <!-- 04 · GET INVOLVED -->
  <Section id="get-involved" index={4} total={4} label="Get involved" dark heading="How Can the Public Get Involved?">
    <Grid>
      <p slot="label" class="mb-0 text-xl text-white/85 leading-snug">
        FSIC is designed to be a community-powered movement, and there are many ways for residents, educators, businesses, and civic partners to participate from the very beginning.
      </p>
      <dl class="mb-8">
        <Row label="Residents can get involved through:" rule="bottom" dark>
          <DashList
            marker="lagoon-light"
            spacious
            class="text-white/85"
            items={[
              'Community STEM nights that bring families together around hands-on learning',
              'Public exhibitions and arts-and-space events that celebrate creativity and innovation',
              'Student programs and camps that spark curiosity and build early skills',
              'Volunteer and mentorship opportunities supporting learners, educators, and small businesses',
              'Employer councils and advisory groups that help shape training, innovation challenges, and regional strategy',
            ]}
          />
        </Row>
      </dl>
      <p class="text-lg text-white/80 max-w-3xl mb-0">
        In addition, FSIC is actively seeking leaders and volunteers with relevant experience across the Center's four core engines — Talent, Innovation, Market, and Civic. Individuals with backgrounds in STEM education, engineering, advanced manufacturing, entrepreneurship, arts and culture, workforce development, community engagement, or related fields are encouraged to step forward. These early contributors will help shape programs, guide partnerships, and build the foundation for FSIC's long-term impact.
      </p>
    </Grid>
  </Section>

  <!-- CLOSING (Master Plan p. 22). "Contact FSIC" opens an email until the Contact page has a form. -->
  <Section rule={false}>
    <Grid>
      <Fragment slot="label"></Fragment>
      <p class="font-display text-3xl md:text-4xl font-semibold text-navy leading-tight mb-10">
        The partnership strategy ensures that FSIC is not duplicating existing efforts but instead coordinating, amplifying, and accelerating them.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <Button href="mailto:info@fsic.space">Contact FSIC</Button>
        <Button href="/model" variant="secondary">Learn More About the FSIC Model</Button>
      </div>
    </Grid>
  </Section>

</BaseLayout>
