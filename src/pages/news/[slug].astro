---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Grid from '../../components/Grid.astro';
import BaseLinks from '../../components/BaseLinks.astro';
import { kindLabel, getReleases, formatDate, firstParagraph, truncate, isoDate, releaseHref, type Release } from '../../lib/news';
import { url } from '../../lib/url';
import { newsArticle } from '../../lib/seo';

// One page per press release (src/content/news/<slug>.md). The text is shown as published.
export async function getStaticPaths() {
  const releases = await getReleases();
  return releases.map((release) => ({
    params: { slug: release.id },
    props: { release, others: releases.filter((r) => r.id !== release.id) },
  }));
}

interface Props {
  release: Release;
  others: Release[];
}

const { release, others } = Astro.props;
const { Content } = await render(release);
const { image, imageAlt, photos = [] } = release.data;
const shareSrc = image ?? photos[0]?.src;
const shareImage = shareSrc ? await getImage({ src: shareSrc, width: 1200, format: 'jpg' }) : undefined;
const description = truncate(firstParagraph(release));
---
<BaseLayout
  title={release.data.title}
  description={description}
  image={shareImage?.src}
  article={{ published: release.data.date }}
  parents={[{ name: 'News & Media', path: '/news/' }]}
  jsonLd={[newsArticle({ headline: release.data.title, path: `/news/${release.id}/`, date: release.data.date, description, image: shareImage?.src })]}
>

  <PageHero title={release.data.title} titleClass="text-4xl md:text-5xl">
    <p class="mb-0 font-sans text-white/75">
      <time datetime={isoDate(release.data.date)}>{formatDate(release.data.date)}</time>
      <span aria-hidden="true"> · </span>{kindLabel(release)}
    </p>
  </PageHero>

  <!-- The release (cols 5–12). The label column holds the way back and, on lg, the graphic published with the release. -->
  <Section>
    <Grid stickyLabel>
      <div slot="label">
        <p class="mb-0 text-label md:pt-label-offset">
          <a href={url('/news')} class="text-navy underline-reveal underline-offset-4">All news and media</a>
        </p>
        {image && imageAlt && (
          <Image
            src={image}
            alt={imageAlt}
            widths={[320, 480, 720]}
            sizes="(min-width: 1024px) 22rem, 20rem"
            class="hidden lg:block mt-6 w-full max-w-sm h-auto"
          />
        )}
      </div>
      <article class="release links-in max-w-3xl">
        <BaseLinks><Content /></BaseLinks>
        {photos.map((photo) => (
          <figure class="mt-10 mb-0">
            <Image
              src={photo.src}
              alt={photo.alt}
              widths={[480, 768, 1024]}
              sizes="(min-width: 768px) 48rem, 100vw"
              class:list={['w-full h-auto', photo.src.height > photo.src.width && 'max-w-md']}
            />
            <figcaption class="mt-2 font-sans text-caption text-gray-dark">
              {photo.caption}{photo.credit && <> Photo: {photo.credit}.</>}
            </figcaption>
          </figure>
        ))}
        {release.data.source && (
          <p class="mt-8 mb-0 font-sans text-caption text-gray-dark">
            First posted on <a href={release.data.source.url} class="link" rel="noopener">{release.data.source.label}</a>.
          </p>
        )}
      </article>
      <!-- Below lg the label column stacks first, so the graphic follows the text there instead of
           pushing the first paragraph below the fold. (On lg it sits in the label column above.) -->
      {image && imageAlt && (
        <Image
          src={image}
          alt={imageAlt}
          widths={[320, 480, 720]}
          sizes="20rem"
          class="lg:hidden mt-10 w-full max-w-xs h-auto"
        />
      )}
    </Grid>

    {others.length > 0 && (
      <Grid class="mt-16 pt-6 border-t border-rule">
        <h2 slot="label" class="mb-0 text-label text-navy md:pt-label-offset">More news</h2>
        <ul role="list" class="divide-y divide-rule">
          {others.map((r) => (
            <li class="py-4 first:pt-0">
              <p class="mb-1 text-caption text-gray-dark">
                <time datetime={isoDate(r.data.date)}>{formatDate(r.data.date)}</time>
              </p>
              <a href={releaseHref(r)} class="font-display text-xl font-semibold text-navy leading-snug underline-reveal underline-offset-4">{r.data.title}</a>
            </li>
          ))}
        </ul>
      </Grid>
    )}
  </Section>

</BaseLayout>
