---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Grid from '../../components/Grid.astro';
import { getReleases, formatDate, firstParagraph, truncate, type Release } from '../../lib/news';

// One page per press release (src/content/news/<slug>.md). The text is shown as published.
export async function getStaticPaths() {
  const releases = await getReleases();
  return releases.map((release) => ({
    params: { slug: release.id },
    props: { release, others: releases.filter((r) => r.id !== release.id) },
  }));
}

interface Props {
  release: Release;
  others: Release[];
}

const { release, others } = Astro.props;
const { Content } = await render(release);
const base = import.meta.env.BASE_URL;
const isoDate = (d: Date) => d.toISOString().slice(0, 10);
---
<BaseLayout title={release.data.title} description={truncate(firstParagraph(release))}>

  <PageHero title={release.data.title} titleClass="text-4xl md:text-5xl">
    <p class="mb-0 font-sans text-white/75">
      <time datetime={isoDate(release.data.date)}>{formatDate(release.data.date)}</time>
      <span aria-hidden="true"> · </span>Press release
    </p>
  </PageHero>

  <!-- The release (cols 5–12), with the way back in the label column -->
  <Section>
    <Grid>
      <p slot="label" class="mb-0 font-sans text-sm font-semibold md:pt-[0.3rem]">
        <a href={`${base}/news`} class="text-navy hover:underline underline-offset-4">All news and media</a>
      </p>
      <article class="release max-w-3xl">
        <Content />
      </article>
    </Grid>

    {others.length > 0 && (
      <Grid class="mt-16 pt-6 border-t border-navy/15">
        <h2 slot="label" class="mb-0 font-sans text-sm font-semibold text-navy md:pt-[0.3rem]">More news</h2>
        <ul role="list" class="divide-y divide-navy/15">
          {others.map((r) => (
            <li class="py-4 first:pt-0">
              <p class="mb-1 font-sans text-sm text-gray-dark">
                <time datetime={isoDate(r.data.date)}>{formatDate(r.data.date)}</time>
              </p>
              <a href={`${base}/news/${r.id}`} class="font-display text-xl font-semibold text-navy leading-snug hover:underline underline-offset-4">{r.data.title}</a>
            </li>
          ))}
        </ul>
      </Grid>
    )}
  </Section>

</BaseLayout>
