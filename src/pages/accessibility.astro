---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Grid from '../components/Grid.astro';
import List from '../components/List.astro';
import { EMAIL, mailto } from '../lib/site';

// Copy: src/content/copy/accessibility.md (Draft). States the target, what the site is built to do
// (DESIGN.md "Accessibility floor") and what hasn't been done yet. No promises FSIC hasn't made. Kept out of
// search and out of the footer until FSIC approves it.
---
<BaseLayout title="Accessibility" description="The Florida Space Innovation Center's accessibility target for its website, how the site is built, and how to report a barrier." noindex>

  <PageHero title="Accessibility">
    <p slot="aside">
      Found a barrier? Email <a href={mailto('Accessibility')} class="link-on-dark">{EMAIL}</a>.
    </p>
    <p class="text-lead text-white/90 mb-0">FSIC wants everyone in Southeast Volusia to be able to use this website.</p>
  </PageHero>

  <Section heading="Our Target">
    <Grid>
      <p slot="label" class="mb-0 text-statement text-navy">WCAG 2.1, Level AA.</p>
      <p class="max-w-3xl mb-0">FSIC aims for the website to meet the Web Content Accessibility Guidelines (WCAG) 2.1 at Level AA.</p>
    </Grid>
  </Section>

  <Section spacing="stacked" heading="How the Site Is Built">
    <Grid>
      <Fragment slot="label"></Fragment>
      <div class="max-w-3xl">
        <List
          spacious
          html
          items={[
            '<strong class="text-navy">Keyboard:</strong> everything that can be clicked can be reached and used with a keyboard, and the keyboard focus is always visible (an orange outline).',
            '<strong class="text-navy">Skip link:</strong> a “Skip to main content” link at the top of every page.',
            '<strong class="text-navy">Structure:</strong> each page has one main heading and headings in order, so screen readers can move by section.',
            '<strong class="text-navy">Images:</strong> every meaningful image has a text description; decorative ones are hidden from screen readers.',
            '<strong class="text-navy">Contrast:</strong> text colors are checked against WCAG AA contrast.',
            '<strong class="text-navy">Text size and zoom:</strong> reading text is 18 pixels on a 28-pixel line, and pages work from 320 pixels wide, so they can be zoomed.',
            '<strong class="text-navy">Motion:</strong> if your device asks for reduced motion, the site turns animation off.',
            '<strong class="text-navy">Without JavaScript:</strong> every page can be read, and the desktop menus open on hover and keyboard focus. The phone menu needs JavaScript, but every page is also linked from the footer.',
          ]}
        />
      </div>
    </Grid>
  </Section>

  <Section spacing="stacked" heading="What We Haven’t Done Yet">
    <Grid>
      <Fragment slot="label"></Fragment>
      <p class="max-w-3xl mb-0">The site hasn’t had a formal accessibility audit or testing with screen readers.</p>
    </Grid>
  </Section>

  <Section spacing="stacked" heading="Feedback">
    <Grid>
      <Fragment slot="label"></Fragment>
      <p class="max-w-3xl mb-0">
        If something on the site is hard to use, email <a href={mailto('Accessibility')} class="link">{EMAIL}</a> with the page and what happened. FSIC will reply and fix what it can.
      </p>
    </Grid>
  </Section>

</BaseLayout>
