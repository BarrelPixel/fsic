---
import Button from './Button.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---
<div class="section--lg">
  <div class="container">
    <div class="max-w-2xl mx-auto text-center">
      <p class="font-sans text-lagoon font-semibold mb-4">Coming soon</p>
      <h1 class="text-3xl md:text-4xl font-bold text-navy mb-6">{title}</h1>
      <p class="text-gray-dark mb-10">{description}</p>
      <Button href="/" variant="secondary">Return to Home</Button>
    </div>
  </div>
</div>
