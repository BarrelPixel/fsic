---
import { pad2 } from '../lib/format';
import Dot from './Dot.astro';
// Section running head (Swiss layout, DESIGN.md "Grid"): a small index and optional label that sit
// just above a section's heavy top rule. Decorative wayfinding, so hidden from screen readers;
// the section's own heading carries the meaning.
interface Props {
  index: number;
  total: number;
  label?: string;
  /** Engine color marker: orange for industry engines, lagoon for Civic. */
  dot?: 'orange' | 'lagoon';
  /** On a night background. */
  dark?: boolean;
}

const { index, total, label, dot, dark = false } = Astro.props;
---
<p
  class:list={[
    'text-caption tabular-nums flex items-center gap-2 mb-2',
    dark ? 'text-white/60' : 'text-gray',
  ]}
  aria-hidden="true"
>
  {dot && (
    <Dot tone={dot} dark={dark} size="md" />
  )}
  <span>{pad2(index)} / {pad2(total)}</span>
  {label && <span class:list={['ml-2', dark ? 'text-white/75' : 'text-gray-dark']}>{label}</span>}
</p>
