---
// A list as lines flush with the column like a paragraph, on the 28px reading leading, with hairline
// rules between items and no markers (DESIGN.md "Structure should show what the content is"). The
// rules come from `.list` in global.css: a rule above the list unless it opens its column, none under
// the last item, and the on-dark rule color inside night sections. When a list's meaning matters
// (problems vs. impact), say it on the list's label: Row's `dot`.
interface Props {
  items: string[];
  /** Two columns from sm (short items only). */
  columns?: boolean;
  /** More room around each item (12px instead of 8px), for items that run to several lines. */
  spacious?: boolean;
  /** Items are trusted, hand-written HTML (links, <strong>), rendered with set:html. */
  html?: boolean;
  class?: string;
}

const { items, columns = false, spacious = false, html = false, class: className } = Astro.props;
---
<ul
  class:list={['list', columns ? 'list-columns grid gap-x-8 sm:grid-cols-2' : 'flex flex-col', spacious && 'list-spacious', className]}
  role="list"
>
  {items.map((item) => (html ? <li set:html={item} /> : <li>{item}</li>))}
</ul>
