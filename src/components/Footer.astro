---
// Footer navigation reads the same structure as the header (src/lib/nav.ts): one column per group,
// then the single links. Each page appears once.
import { getNavColumns, href as navHref } from '../lib/nav';
import { EMAIL, mailto, SOCIAL_LINKS, ORG } from '../lib/site';
import { url } from '../lib/url';
import SolicitationDisclosure from './SolicitationDisclosure.astro';

const columns = getNavColumns();

---
<footer class="font-sans bg-night text-white/75 border-t border-white/10" role="contentinfo">
  <div class="container py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- Brand -->
      <div>
        <img
          src={url('/images/fsic-logo-reverse.png')}
          alt="Florida Space Innovation Center"
          width="300"
          height="128"
          loading="lazy"
          class="h-16 w-auto mb-4"
        />
        <p class="text-sm text-lagoon-light font-medium mb-4">Southeast Volusia County, Florida</p>
        <p class="text-caption">
          A coordinated regional platform strengthening workforce, innovation, and economic growth for the Space Coast.
        </p>
        <p class="text-sm mt-4">
          <a href={mailto()} class="text-white/75 hover:text-white underline underline-offset-4 decoration-white/30">{EMAIL}</a>
        </p>
        <ul class="flex gap-5 mt-4" role="list">
          {SOCIAL_LINKS.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-white/75 hover:text-white transition-colors" rel="noopener">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Site navigation, grouped as in the header -->
      <nav class="md:col-span-2 grid grid-cols-2 sm:grid-cols-4 gap-8" aria-label="Footer navigation">
        {columns.map((col) => (
          <div>
            <p class="text-white font-semibold text-sm mb-4">{col.label}</p>
            <ul class="flex flex-col gap-2" role="list">
              {col.links.map((link) => (
                <li>
                  <a href={navHref(link.path)} class="text-sm text-white/75 hover:text-white transition-colors">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-white/10 mt-12 pt-8 flex flex-col sm:flex-row sm:flex-wrap justify-between items-center gap-4">
      <p class="text-xs text-white/60">
        &copy; {new Date().getFullYear()} {ORG.legalName} All rights reserved. A {ORG.status}, EIN <span class="whitespace-nowrap">{ORG.ein}</span>.
      </p>
      <SolicitationDisclosure dark class="sm:order-last sm:basis-full" />
      <p class="text-xs text-white/60">
        Built by <span class="text-white/75">Barrel &amp; Pixel</span>
      </p>
    </div>
  </div>
</footer>
