---
// A label | content row inside the content column (DESIGN.md "Grid"): 2 + 6 of 8 columns from md.
// Use inside a <dl>. The label shares the first line of its content (md:pt-label-offset).
//   rule="top"     hairline above (rows that follow other content)
//   rule="bottom"  hairline below (a row that opens the content column, so it keeps the shared top line)
//   list           the content is a list of <details> items, so pull it up to the label's line
interface Props {
  label: string;
  /** Shown after the label in grey, e.g. "Components · 6". */
  count?: number;
  rule?: 'top' | 'bottom';
  list?: boolean;
  dark?: boolean;
  /** A dot after the label (so every label starts on the column edge) that says what the list beside it is: gray for problems, the engine
   *  color for impact, navy for neutral (DESIGN.md). */
  dot?: 'gray' | 'navy' | 'orange' | 'lagoon' | 'lagoon-light';
  class?: string;
}

const { label, count, rule = 'top', list = false, dark = false, dot, class: className } = Astro.props;
const dotClass = dot && { gray: 'bg-gray/60', navy: 'bg-navy', orange: 'bg-orange', lagoon: 'bg-lagoon', 'lagoon-light': 'bg-lagoon-light' }[dot];
const line = dark ? 'border-rule-on-dark' : 'border-rule';
---
<div
  class:list={[
    'grid gap-y-3 md:grid-cols-8 md:gap-x-8',
    rule === 'top' ? ['border-t', line, list ? 'pt-5' : 'py-5'] : ['border-b', line, 'pb-6'],
    className,
  ]}
>
  <dt class:list={['md:col-span-2 md:pt-label-offset text-label', dark ? 'text-white' : 'text-navy']}>
    {label}
    {count !== undefined && <span class="font-medium text-gray"> · {count}</span>}
    {dotClass && <span class:list={['inline-block w-2 h-2 rounded-full ml-2 align-[0.05em]', dotClass]} aria-hidden="true"></span>}
  </dt>
  <dd class:list={['md:col-span-6', list && 'md:-mt-3']}>
    <slot />
  </dd>
</div>
