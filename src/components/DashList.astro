---
// A list with short dash markers (DESIGN.md "Structure should show what the content is").
// Marker color carries meaning: gray = problems, navy = neutral points, orange / lagoon = impact
// for an industry or community engine, lagoon-light = community items on night.
interface Props {
  items: string[];
  marker?: 'gray' | 'navy' | 'orange' | 'lagoon' | 'lagoon-light';
  /** Two columns from sm (short items only). */
  columns?: boolean;
  /** More space between items, for longer lines at text-lg. */
  spacious?: boolean;
  /** Items are trusted, hand-written HTML (links, <strong>), rendered with set:html. */
  html?: boolean;
  class?: string;
}

const { items, marker = 'navy', columns = false, spacious = false, html = false, class: className } = Astro.props;
const markerClass = {
  gray: 'bg-gray/60',
  navy: 'bg-navy',
  orange: 'bg-orange',
  lagoon: 'bg-lagoon',
  'lagoon-light': 'bg-lagoon-light',
}[marker];
---
<ul
  class:list={[columns ? 'grid gap-x-8 gap-y-2 sm:grid-cols-2' : ['flex flex-col', spacious ? 'gap-3' : 'gap-2'], className]}
  role="list"
>
  {items.map((item) => (
    <li class="flex gap-3 leading-snug">
      <span class:list={['mt-[0.6em] w-3 h-0.5 shrink-0', markerClass]} aria-hidden="true"></span>
      {html ? <span set:html={item} /> : item}
    </li>
  ))}
</ul>
