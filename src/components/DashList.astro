---
// A list with short dash markers (DESIGN.md "Structure should show what the content is"). The text sits
// flush with the column like a paragraph; the 8px dash hangs 14px into the gutter on its left.
// Marker color carries meaning: gray = problems, navy = neutral points, orange / lagoon = impact
// for an industry or community engine, lagoon-light = community items on night.
interface Props {
  items: string[];
  marker?: 'gray' | 'navy' | 'orange' | 'lagoon' | 'lagoon-light';
  /** Two columns from sm (short items only). */
  columns?: boolean;
  /** Space between items (8px), for items that run to several lines. Otherwise items follow on the
   *  28px line, and the dash marks where each one starts. */
  spacious?: boolean;
  /** Items are trusted, hand-written HTML (links, <strong>), rendered with set:html. */
  html?: boolean;
  class?: string;
}

const { items, marker = 'navy', columns = false, spacious = false, html = false, class: className } = Astro.props;
const markerClass = {
  gray: 'bg-gray/60',
  navy: 'bg-navy',
  orange: 'bg-orange',
  lagoon: 'bg-lagoon',
  'lagoon-light': 'bg-lagoon-light',
}[marker];
---
<ul
  class:list={[columns ? 'grid gap-x-8 sm:grid-cols-2' : ['flex flex-col', spacious && 'gap-2'], className]}
  role="list"
>
  {items.map((item) => (
    <li class="relative">
      <span class:list={['absolute -left-3.5 top-[calc(0.5lh+0.1em-1px)] w-2 h-0.5', markerClass]} aria-hidden="true"></span>
      {html ? <span set:html={item} /> : item}
    </li>
  ))}
</ul>
