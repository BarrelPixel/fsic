---
// One span of years on the Years 1–5 track, under a YearScale. Decorative: the timeframe is always in the
// text beside it. The bar's color says what it is (`tone`, src/lib/tones.ts) unless `barClass` is given (the
// funding streams, which are not engines). No start: an empty track (a stream with no timeframe).
//   size  sm 10px (homepage), md 12px (Deployment, Partnership & Funding)
import { toneBg, type Tone } from '../lib/tones';

interface Props {
  start: number | null;
  end: number | null;
  tone?: Tone;
  barClass?: string;
  dark?: boolean;
  size?: 'sm' | 'md';
  class?: string;
}
const { start, end, tone = 'navy', barClass, dark = false, size = 'md', class: className } = Astro.props;
---
<span class:list={['grid grid-cols-5', size === 'sm' ? 'h-2.5' : 'h-3', dark ? 'bg-white/[0.06]' : 'bg-navy/[0.07]', className]} aria-hidden="true">
  {start !== null && end !== null && (
    <span class:list={['h-full', barClass ?? toneBg(tone, dark)]} style={`grid-column: ${start} / ${end + 1}`}></span>
  )}
</span>
