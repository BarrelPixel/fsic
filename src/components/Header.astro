---
// Main navigation. The structure lives in src/lib/nav.ts (shared with the footer).
// Groups are disclosure buttons (aria-expanded), not ARIA menus: they open on click and close on
// Escape, an outside click, or when focus leaves. Without JS they open on hover and focus-within
// (global.css, "Navigation dropdowns"). The script adds aria-expanded and aria-controls when it runs,
// so without JS the buttons don't announce a collapsed state while their panel is showing.
import { getNav, isGroup, href as navHref } from '../lib/nav';
import { url } from '../lib/url';

const nav = getNav();

const stripSlash = (path: string) => (path.length > 1 ? path.replace(/\/+$/, '') : path);
const currentPath = stripSlash(Astro.url.pathname);
const homePath = stripSlash(url('/'));

// Home matches only itself; other items also match their sub-pages.
const isActive = (href: string) => {
  const target = stripSlash(href);
  if (target === homePath) return currentPath === homePath;
  return currentPath === target || currentPath.startsWith(`${target}/`);
};

const items = nav.map((item, i) =>
  isGroup(item)
    ? {
        kind: 'group' as const,
        id: `nav-group-${i}`,
        label: item.label,
        links: item.links.map((l) => ({ label: l.label, href: navHref(l.path), active: isActive(navHref(l.path)) })),
      }
    : { kind: 'link' as const, label: item.label, href: navHref(item.path), active: isActive(navHref(item.path)), cta: item.cta === true },
);

// Phone menu: the groups, then the single links together, then the call to action as a button.
type Item = (typeof items)[number];
type GroupItem = Extract<Item, { kind: 'group' }>;
type LinkItem = Extract<Item, { kind: 'link' }>;
const mobileGroups = items.filter((item): item is GroupItem => item.kind === 'group');
const singles = items.filter((item): item is LinkItem => item.kind === 'link');
const mobileLinks = singles.filter((item) => !item.cta);
const mobileCta = singles.find((item) => item.cta);

// Phone menu links: larger than the group names, so the names read as headings. The current page has
// a white bar just outside the text's left edge (-ml-3.5 = the 2px bar + 12px padding), so the text
// stays aligned with the group names. Rows are 44px, the minimum touch target.
const mobileLinkClass = (active: boolean) => [
  'block -ml-3.5 pl-3 pr-3 py-2 text-lg border-l-2 transition-colors',
  active ? 'border-white bg-white/10 text-white font-semibold' : 'border-transparent font-medium text-white/90 hover:text-white hover:bg-white/10',
];
const groupActive = (links: { active: boolean }[]) => links.some((l) => l.active);

const itemClass = (active: boolean) => [
  'px-3 py-2 text-sm font-medium transition-colors',
  active ? 'bg-white/15 text-white' : 'text-white/75 hover:text-white hover:bg-white/10',
];
---
<header class="font-sans bg-night text-white relative z-50 border-b border-white/10 [view-transition-name:site-header]">
  <!-- Above the phone menu's backdrop (z-39), so the header and its close button stay bright and tappable -->
  <div class="container relative z-[41]">
    <nav class="flex items-center justify-between py-3" aria-label="Main navigation">
      <a href={url('/')} class="block shrink-0 hover:opacity-90 transition-opacity">
        <img
          src={url('/images/fsic-logo-reverse.png')}
          alt="Florida Space Innovation Center"
          width="300"
          height="128"
          class="h-14 w-auto lg:h-16"
        />
      </a>

      <!-- Desktop Nav -->
      <ul class="hidden lg:flex items-center gap-1" role="list">
        {items.map((item) =>
          item.kind === 'group' ? (
            <li class="relative" data-nav-group>
              <button
                type="button"
                class:list={[itemClass(groupActive(item.links)), 'inline-flex items-center gap-1.5']}
                data-controls={item.id}
              >
                {item.label}
                <svg class="nav-chevron w-3.5 h-3.5 transition-transform" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M5 8l5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <div id={item.id} class="nav-panel absolute left-0 top-full pt-2 min-w-60" data-nav-panel>
                <ul class="bg-night border border-white/15 p-2" role="list">
                  {item.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        class:list={['block', itemClass(link.active)]}
                        aria-current={link.active ? 'page' : undefined}
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ) : (
            <li>
              <a href={item.href} class:list={itemClass(item.active)} aria-current={item.active ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ),
        )}
      </ul>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="lg:hidden p-2 text-white hover:bg-white/10 transition-colors"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" stroke-width="2" stroke-linecap="round">
          <path class="menu-icon-line menu-icon-line-1" d="M4 6h16" />
          <path class="menu-icon-line menu-icon-line-2" d="M4 12h16" />
          <path class="menu-icon-line menu-icon-line-3" d="M4 18h16" />
        </svg>
      </button>
    </nav>
  </div>

  <!-- Mobile Menu Backdrop -->
  <div id="mobile-menu-backdrop" class="mobile-menu-backdrop hidden lg:hidden"></div>

  <!-- Mobile Menu (DESIGN.md "Components", Header): Overlays content instead of pushing it down.
       Each group under its name (small label); single links in two columns; Get Involved as button.
       Pages are larger than group names, so groups read as headings over their pages. -->
  <div id="mobile-menu" class="mobile-menu hidden lg:hidden bg-night border-t border-white/10">
    <div class="container pt-1 pb-5">
      {mobileGroups.map((group) => (
        <div class="py-2.5 border-b border-white/10">
          <p id={`${group.id}-m`} class="mb-1 text-label text-white/60">{group.label}</p>
          <ul role="list" aria-labelledby={`${group.id}-m`}>
            {group.links.map((link) => (
              <li>
                <a href={link.href} class:list={mobileLinkClass(link.active)} aria-current={link.active ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <ul class="py-2.5 grid grid-cols-2 gap-x-8" role="list">
        {mobileLinks.map((link) => (
          <li>
            <a href={link.href} class:list={mobileLinkClass(link.active)} aria-current={link.active ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      {mobileCta && (
        <a
          href={mobileCta.href}
          class="flex items-center justify-center w-full px-7 py-3.5 font-semibold border-2 border-orange-deep bg-orange-deep text-white hover:bg-orange-deeper hover:border-orange-deeper transition-colors"
          aria-current={mobileCta.active ? 'page' : undefined}
        >
          {mobileCta.label}
        </a>
      )}
    </div>
  </div>
</header>

<script>
  // Mobile menu
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const backdrop = document.getElementById('mobile-menu-backdrop');

  const setMenu = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.classList.toggle('menu-open', open);
    menu?.classList.toggle('hidden', !open);
    backdrop?.classList.toggle('hidden', !open);
    // The page under the open menu is covered by its backdrop: make it inert, so Tab stays in the menu and
    // never lands on a link the menu hides (WCAG 2.4.11), and screen readers read only the menu.
    document.querySelectorAll('.skip-link, #main-content, footer').forEach((el) => el.toggleAttribute('inert', open));
    
    // Prevent body scroll when menu is open
    if (open) {
      document.body.style.overflow = 'hidden';
    } else {
      document.body.style.overflow = '';
    }
  };
  const menuOpen = () => toggle?.getAttribute('aria-expanded') === 'true';

  toggle?.addEventListener('click', () => setMenu(!menuOpen()));
  
  // Clicking backdrop closes menu
  backdrop?.addEventListener('click', () => setMenu(false));
  
  // Escape closes the phone menu and returns focus to its button, as with the dropdowns.
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuOpen()) {
      setMenu(false);
      toggle?.focus();
    }
  });

  // Desktop dropdowns (disclosure pattern)
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-group]'));
  const buttonOf = (group: HTMLElement) => group.querySelector<HTMLButtonElement>('button')!;

  const setOpen = (group: HTMLElement, open: boolean) => {
    group.toggleAttribute('data-open', open);
    buttonOf(group).setAttribute('aria-expanded', String(open));
  };

  groups.forEach((group) => {
    const button = buttonOf(group);
    // State attributes only exist once the script runs (see the note at the top of this file).
    button.setAttribute('aria-expanded', 'false');
    if (button.dataset.controls) button.setAttribute('aria-controls', button.dataset.controls);
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') !== 'true';
      groups.forEach((g) => g !== group && setOpen(g, false));
      setOpen(group, open);
    });
    group.addEventListener('focusout', (event) => {
      if (!group.contains(event.relatedTarget as Node | null)) setOpen(group, false);
    });
    group.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && group.hasAttribute('data-open')) {
        setOpen(group, false);
        button.focus();
      }
    });
  });

  document.addEventListener('click', (event) => {
    groups.forEach((g) => !g.contains(event.target as Node) && setOpen(g, false));
  });
</script>
