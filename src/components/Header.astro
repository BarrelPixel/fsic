---
const base = import.meta.env.BASE_URL;
const navItems = [
  { label: 'Home', href: base },
  { label: 'The Model', href: `${base}/model` },
  { label: 'Economic Impact', href: `${base}/economic-impact` },
  { label: 'Deployment', href: `${base}/deployment` },
  { label: 'Governance', href: `${base}/governance` },
  { label: 'Contact', href: `${base}/contact` },
];

const stripSlash = (path: string) => (path.length > 1 ? path.replace(/\/+$/, '') : path);
const currentPath = stripSlash(Astro.url.pathname);
const homePath = stripSlash(base);

// Home matches only itself; other items also match their sub-pages.
const isActive = (href: string) => {
  const target = stripSlash(href);
  if (target === homePath) return currentPath === homePath;
  return currentPath === target || currentPath.startsWith(`${target}/`);
};
---
<header class="bg-night text-white relative z-50 border-b border-white/10">
  <div class="container">
    <nav class="flex items-center justify-between py-4" aria-label="Main navigation">
      <a href={base} class="leading-tight hover:opacity-90 transition-opacity">
        <span class="block text-lg font-bold [font-stretch:125%]">Florida Space</span>
        <span class="block text-sm font-medium text-white/70 [font-stretch:112%]">Innovation Center</span>
      </a>

      <!-- Desktop Nav -->
      <ul class="hidden lg:flex items-center gap-1" role="list">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'px-3 py-2 text-sm font-medium rounded transition-colors',
                isActive(item.href)
                  ? 'bg-white/15 text-white'
                  : 'text-white/80 hover:text-white hover:bg-white/10',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-toggle"
        class="lg:hidden p-2 text-white hover:bg-white/10 rounded transition-colors"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          <path id="close-icon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-night border-t border-white/10">
    <div class="container py-4">
      <ul class="flex flex-col gap-1" role="list">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'block px-3 py-2.5 text-sm font-medium rounded transition-colors',
                isActive(item.href)
                  ? 'bg-white/15 text-white'
                  : 'text-white/80 hover:text-white hover:bg-white/10',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });
</script>
