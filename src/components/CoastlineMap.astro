---
/**
 * Schematic map of the Space Coast, from Cape Canaveral north to
 * Edgewater and New Smyrna Beach. North is up; ocean is to the right.
 * The orange launch arc rises from the Cape and bends north to
 * Southeast Volusia: the FSIC mission in one line. Not to scale.
 */
---
<figure class="coast-map w-full max-w-[30rem] mx-auto lg:mx-0">
  <svg
    viewBox="0 0 480 560"
    class="w-full h-auto"
    role="img"
    aria-labelledby="coast-map-title coast-map-desc"
  >
    <title id="coast-map-title">The Space Coast, from Cape Canaveral to Southeast Volusia</title>
    <desc id="coast-map-desc">
      A schematic map of Florida's east coast. A launch arc rises from Cape Canaveral
      and curves north to land at New Smyrna Beach and Edgewater.
    </desc>

    <defs>
      <!-- Fade the land out at the map edges so there is no hard frame -->
      <linearGradient id="land-fade-x" x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#fff" stop-opacity="0" />
        <stop offset="0.45" stop-color="#fff" stop-opacity="1" />
      </linearGradient>
      <linearGradient id="land-fade-y" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0" stop-color="#fff" stop-opacity="0" />
        <stop offset="0.12" stop-color="#fff" stop-opacity="1" />
        <stop offset="0.85" stop-color="#fff" stop-opacity="1" />
        <stop offset="1" stop-color="#fff" stop-opacity="0" />
      </linearGradient>
      <mask id="land-mask-x"><rect width="480" height="560" fill="url(#land-fade-x)" /></mask>
      <mask id="land-mask-y"><rect width="480" height="560" fill="url(#land-fade-y)" /></mask>
    </defs>

    <g mask="url(#land-mask-y)">
    <g mask="url(#land-mask-x)">
    <!-- Land (mainland and barrier islands) -->
    <path
      d="M 178 0 C 185 60, 195 90, 210 130 C 250 220, 320 330, 370 400 C 395 435, 412 460, 418 478 C 405 490, 390 505, 382 560 L 0 560 L 0 0 Z"
      fill="var(--color-lagoon)"
      fill-opacity="0.28"
    />
    <!-- Coastline -->
    <path
      d="M 178 0 C 185 60, 195 90, 210 130 C 250 220, 320 330, 370 400 C 395 435, 412 460, 418 478 C 405 490, 390 505, 382 560"
      fill="none"
      stroke="var(--color-lagoon-light)"
      stroke-width="1.5"
    />
    </g>
    <!-- Lagoon behind the barrier island -->
    <path
      d="M 190 130 C 215 190, 255 260, 300 330 C 320 360, 340 385, 350 398 C 342 402, 336 400, 330 394 C 310 370, 290 345, 282 334 C 240 268, 200 200, 178 140 Z"
      fill="var(--color-night)"
      stroke="var(--color-lagoon-light)"
      stroke-opacity="0.5"
      stroke-width="1"
    />
    </g>

    <!-- Ocean label -->
    <text x="395" y="252" fill="#FFFFFF" fill-opacity="0.38" font-size="13" text-anchor="end" font-style="italic">
      Atlantic Ocean
    </text>

    <!-- North marker -->
    <g fill="none" stroke="#FFFFFF" stroke-opacity="0.45" stroke-width="1.25">
      <line x1="452" y1="46" x2="452" y2="22" />
      <polyline points="446,30 452,22 458,30" />
    </g>
    <text x="452" y="62" fill="#FFFFFF" fill-opacity="0.45" font-size="12" text-anchor="middle">N</text>

    <!-- Launch arc: Cape Canaveral to Southeast Volusia -->
    <path
      class="launch-arc"
      pathLength="1"
      d="M 400 462 C 470 360, 430 150, 192 92"
      fill="none"
      stroke="var(--color-orange)"
      stroke-width="3"
      stroke-linecap="round"
    />

    <!-- Cape Canaveral launch site -->
    <polygon points="400,452 407,466 393,466" fill="var(--color-orange)" />
    <text x="384" y="480" fill="#FFFFFF" fill-opacity="0.8" font-size="14" text-anchor="end">
      Cape Canaveral
    </text>

    <!-- Southeast Volusia: where the arc lands -->
    <g class="launch-arc-end">
      <circle cx="186" cy="90" r="14" fill="var(--color-orange)" fill-opacity="0.18" />
    </g>
    <circle cx="186" cy="90" r="5" fill="#FFFFFF" />
    <text x="172" y="86" fill="#FFFFFF" font-size="15" font-weight="600" text-anchor="end">
      New Smyrna Beach
    </text>
    <circle cx="170" cy="122" r="4" fill="#FFFFFF" fill-opacity="0.85" />
    <text x="158" y="127" fill="#FFFFFF" fill-opacity="0.85" font-size="14" text-anchor="end">
      Edgewater
    </text>
  </svg>
  <figcaption class="mt-2 text-sm text-white/55">Schematic, not to scale.</figcaption>
</figure>

<script>
  // Draw the launch arc when the map comes into view (it sits below the fold on phones).
  // Without JS the arc is simply shown complete.
  const maps = document.querySelectorAll('.coast-map');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-drawn');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.4 });
    maps.forEach((m) => io.observe(m));
  } else {
    maps.forEach((m) => m.classList.add('is-drawn'));
  }
</script>
