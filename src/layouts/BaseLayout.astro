---
// Fonts are self-hosted (Fontsource), in the weights the design uses: Barlow Semi Condensed for
// headlines, Source Serif 4 (variable, with optical sizes) for reading text, Archivo (variable) for UI.
import '@fontsource/barlow-semi-condensed/500.css';
import '@fontsource/barlow-semi-condensed/600.css';
import '@fontsource/barlow-semi-condensed/700.css';
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/archivo/wght.css';
import '../styles/global.css';
// The Latin files every page needs first (body text, the h1, the header), preloaded so text doesn't swap late.
import serifLatin from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-opsz-normal.woff2?url';
import displayLatin from '@fontsource/barlow-semi-condensed/files/barlow-semi-condensed-latin-700-normal.woff2?url';
import sansLatin from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Share image path from Astro's image pipeline (already includes the base path). */
  image?: string;
  /** Keep the page out of search results (the 404 page). It then has no canonical URL either. */
  noindex?: boolean;
}

const { title, image, noindex = false, description = 'The Florida Space Innovation Center is a coordinated regional platform strengthening workforce, innovation, and economic growth for Southeast Volusia and the Space Coast.' } = Astro.props;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
// The page's own address on the deployed site (astro.config.mjs `site` + base path). Every page is built
// as a directory (…/page/index.html), so its address ends in a slash; the homepage would otherwise lack one.
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site).href;
const pageTitle = title === 'Florida Space Innovation Center' ? title : `${title} | Florida Space Innovation Center`;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="Florida Space Innovation Center" />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />

    {[serifLatin, displayLatin, sansLatin].map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
  </head>
  <body class="min-h-screen flex flex-col bg-white text-gray-dark">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />

  </body>
</html>
