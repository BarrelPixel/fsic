---
// Fonts are self-hosted (Fontsource), in the weights the design uses: Barlow Semi Condensed for
// headlines, Source Serif 4 (variable, with optical sizes) for reading text, Archivo (variable) for UI.
import '@fontsource/barlow-semi-condensed/500.css';
import '@fontsource/barlow-semi-condensed/600.css';
import '@fontsource/barlow-semi-condensed/700.css';
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/archivo/wght.css';
import '../styles/global.css';
// The Latin files every page needs first (body text, the h1, the header), preloaded so text doesn't swap late.
import serifLatin from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-opsz-normal.woff2?url';
import displayLatin from '@fontsource/barlow-semi-condensed/files/barlow-semi-condensed-latin-700-normal.woff2?url';
import sansLatin from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';
import { getImage } from 'astro:assets';
import heroImage from '../assets/fsic-hero.png';
import { INDEXABLE, organization, website, breadcrumb } from '../lib/seo';
import { HAS_PUBLISHED_POSTS } from '../lib/blog-status';

interface Props {
  title: string;
  description?: string;
  /** Share image path from Astro's image pipeline (already includes the base path). */
  image?: string;
  /** Keep the page out of search results (the 404 page). It then has no canonical URL either. */
  noindex?: boolean;
  /** A press release: og:type article with its publication date. */
  article?: { published: Date };
  /** Pages between Home and this one in the breadcrumb (a release: News & Media). */
  parents?: { name: string; path: string }[];
  /** Extra schema.org records for this page (FAQPage, NewsArticle), added to the Organization. */
  jsonLd?: Record<string, unknown>[];
}

const { title, image, noindex = false, article, parents = [], jsonLd = [], description = 'The Florida Space Innovation Center is a coordinated regional platform strengthening workforce, innovation, and economic growth for Southeast Volusia and the Space Coast.' } = Astro.props;
// Every page has a share image: its own, or the hero photo (docs/13 B5).
const share = image ?? (await getImage({ src: heroImage, width: 1200, format: 'jpg' })).src;
const ogImage = new URL(share, Astro.site).href;
// The preview is never indexed (src/lib/seo.ts INDEXABLE); at fsic.space only noindex pages are left out.
const robotsNoindex = noindex || !INDEXABLE;
// The page's own address on the deployed site (astro.config.mjs `site` + base path). Every page is built
// as a directory (…/page/index.html), so its address ends in a slash; the homepage would otherwise lack one.
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site).href;
// Titles that already name FSIC (the homepage, press releases) don't repeat it (docs/13 B6).
const pageTitle = title.includes('Florida Space Innovation Center') ? title : `${title} | Florida Space Innovation Center`;
// schema.org (docs/13 B1): FSIC on every page; the site on the homepage; a breadcrumb on the rest.
const isHome = Astro.url.pathname.replace(/\/+$/, '') === url('/').replace(/\/+$/, '');
const graph = [
  organization(),
  ...(isHome ? [website()] : noindex ? [] : [breadcrumb([...parents, { name: title, path: Astro.url.pathname.slice(url('/').length - 1) || '/' }])]),
  ...jsonLd,
];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {robotsNoindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.published.toISOString().slice(0, 10)} />}
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="Florida Space Innovation Center" />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c')} />

    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    {HAS_PUBLISHED_POSTS && <link rel="alternate" type="application/rss+xml" title="Florida Space Innovation Center: Blog" href={url('/blog/rss.xml')} />}

    {[serifLatin, displayLatin, sansLatin].map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
  </head>
  <body class="min-h-screen flex flex-col bg-white text-gray-dark">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />

  </body>
</html>
